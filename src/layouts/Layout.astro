---
import { SITE } from '@/config';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import Preloader from '@/components/Preloader.astro';
import ScrollProgress from '@/components/ScrollProgress.astro';
import MobileCTA from '@/components/MobileCTA.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  preloadImage?: string;
}

const { title, description, canonical, ogImage, noindex, schema, preloadImage } = Astro.props;
const canonicalURL = canonical || new URL(Astro.url.pathname, SITE.url).href;
const ogImageURL = ogImage || `${SITE.url}/og-image.jpg`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1A1D23" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {preloadImage && <link rel="preload" as="image" href={preloadImage} />}

    <!-- Fonts — self-hosted (no external DNS) -->
    <link rel="preload" href="/fonts/dm-serif-display-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-serif-display-italic-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {schema && (
      Array.isArray(schema) ? (
        schema.map((s) => (
          <script type="application/ld+json" set:html={JSON.stringify(s)} />
        ))
      ) : (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      )
    )}
  </head>
  <body>
    <Preloader />
    <ScrollProgress />

    <a href="#main-content" class="skip-link" style="padding: 10px 20px;">
      Skip to main content
    </a>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
    <MobileCTA />
    <CookieConsent />

    <script>
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      declare global {
        interface Window {
          __lenis?: InstanceType<typeof Lenis>;
        }
      }

      if (!prefersReducedMotion) {
        Promise.all([
          import('gsap'),
          import('gsap/ScrollTrigger'),
          import('lenis'),
        ]).then(([{ gsap }, { ScrollTrigger }, { default: Lenis }]) => {
          gsap.registerPlugin(ScrollTrigger);

          window.__lenis = new Lenis({
            duration: 1.2,
            easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            touchMultiplier: 2,
          });

          const lenis = window.__lenis;
          lenis.on('scroll', ScrollTrigger.update);

          gsap.ticker.add((time: number) => {
            lenis.raf(time * 1000);
          });

          gsap.ticker.lagSmoothing(0);

          // VARIED REVEAL ANIMATIONS — different per data-reveal type
          gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
            const type = el.getAttribute('data-reveal') || 'up';
            let from: Record<string, number> = {};
            let to: Record<string, number | string> = { opacity: 1, duration: 1, ease: 'power3.out' };

            switch (type) {
              case 'right':
                from = { opacity: 0, x: -50 };
                to = { ...to, x: 0 };
                break;
              case 'left':
                from = { opacity: 0, x: 50 };
                to = { ...to, x: 0 };
                break;
              case 'scale':
                from = { opacity: 0, scale: 0.9 };
                to = { ...to, scale: 1 };
                break;
              case 'clip':
                from = { opacity: 0, y: 60 };
                to = { ...to, y: 0, duration: 1.2, ease: 'power4.out' };
                break;
              case 'fade':
                from = { opacity: 0 };
                to = { ...to, duration: 0.8 };
                break;
              default:
                from = { opacity: 0, y: 35 };
                to = { ...to, y: 0 };
                break;
            }

            gsap.fromTo(el, from, {
              ...to,
              scrollTrigger: {
                trigger: el,
                start: 'top 85%',
                once: true,
              },
            });
          });

          // Staggered reveals — alternating entry directions
          gsap.utils.toArray<HTMLElement>('[data-stagger-parent]').forEach((parent, idx) => {
            const children = parent.querySelectorAll('[data-stagger-child]');
            const fromRight = idx % 2 === 1;
            gsap.fromTo(
              children,
              { opacity: 0, y: 20, x: fromRight ? 15 : -15 },
              {
                opacity: 1,
                y: 0,
                x: 0,
                duration: 0.7,
                stagger: 0.12,
                ease: 'power3.out',
                scrollTrigger: {
                  trigger: parent,
                  start: 'top 80%',
                  once: true,
                },
              }
            );
          });
        });
      } else {
        // Show everything immediately
        document.querySelectorAll('[data-reveal], [data-stagger-child]').forEach((el) => {
          (el as HTMLElement).style.opacity = '1';
          (el as HTMLElement).style.transform = 'none';
        });
      }
    </script>
  </body>
</html>
