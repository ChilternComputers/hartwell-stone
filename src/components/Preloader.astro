---
---

<div class="preloader" id="preloader" aria-hidden="true">
  <span class="preloader-monogram" id="preloader-mono">H&S</span>
  <div class="preloader-line" id="preloader-line"></div>
</div>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const preloader = document.getElementById('preloader');

  const alreadyVisited = sessionStorage.getItem('hs-visited');
  if (prefersReducedMotion || !preloader || alreadyVisited) {
    preloader?.remove();
  } else {
    sessionStorage.setItem('hs-visited', '1');
    // CSS animations are already running from the stylesheet.
    // Just clean up the DOM element after the fade-out completes.
    preloader.addEventListener('animationend', (e) => {
      if ((e as AnimationEvent).animationName === 'preloader-fade-out') {
        preloader.remove();
      }
    });
  }
</script>
