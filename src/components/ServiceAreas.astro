---
const areas = [
  'Chelmsford', 'Brentwood', 'Billericay', 'Romford',
  'Hornchurch', 'Basildon', 'Southend', 'Colchester',
  'Maldon', 'Rayleigh', 'Wickford', 'Ingatestone',
];
---

<section style="padding: 96px 0; background: var(--color-stone);">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
    <div class="grid grid-cols-1 lg:grid-cols-2" style="gap: 48px; align-items: center;">
      <div data-reveal>
        <span class="eyebrow" style="display: block; margin-bottom: 12px;">Coverage</span>
        <h2 class="font-heading" style="margin-bottom: 20px;">Serving Essex & Beyond</h2>
        <p style="font-size: 0.95rem; color: rgba(44,44,46,0.7); line-height: 1.8; margin-bottom: 24px;">
          Based in Chelmsford, we serve homeowners across Essex and into East London. From the coast to the countryside, our team delivers the same exceptional quality wherever your project is located.
        </p>
        <a href="/areas/" class="btn-primary btn-outline" style="padding: 12px 28px;">
          View All Areas
        </a>
      </div>

      <div data-reveal>
        <div style="display: flex; flex-wrap: wrap; gap: 10px;">
          {areas.map((area) => (
            <a
              href="/areas/"
              style="padding: 10px 20px; background: var(--color-warm-white); border: 1px solid var(--color-border); font-size: 0.85rem; font-weight: 500; color: var(--color-text-dark); transition: all 0.3s ease; text-decoration: none;"
            >
              {area}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
