---
import { areas } from '@/data/areas';

const featureAreas = areas.slice(0, 12);
---

<section style="padding: 96px 0; background: var(--color-stone);">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
    <div class="grid grid-cols-1 lg:grid-cols-2" style="gap: 48px; align-items: center;">
      <div data-reveal>
        <span class="eyebrow" style="display: block; margin-bottom: 12px;">Coverage</span>
        <h2 class="font-heading" style="margin-bottom: 20px;">Based in Essex, Working Nationwide</h2>
        <p style="font-size: 0.95rem; color: var(--color-text-secondary); line-height: 1.8; margin-bottom: 16px;">
          Our headquarters in Chelmsford places us at the heart of Essex, with easy reach across the South East. For larger commissions — typically new builds and heritage projects above £500,000 — we work nationwide by arrangement.
        </p>
        <p style="font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.7; margin-bottom: 24px; font-style: italic;">
          Current furthest project: barn conversion in the Cotswolds
        </p>
        <a href="/areas/" class="btn-primary btn-outline" style="padding: 12px 28px;">
          View All Areas
        </a>
      </div>

      <div data-reveal>
        <div style="display: flex; flex-wrap: wrap; gap: 10px;">
          {featureAreas.map((area) => (
            <a
              href={`/areas/${area.slug}/`}
              style="padding: 10px 20px; background: var(--color-warm-white); border: 1px solid var(--color-border); font-size: 0.85rem; font-weight: 500; color: var(--color-text-dark); transition: all 0.3s ease; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center;"
            >
              {area.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
