---
---

<section style="padding: 80px 0; background: var(--color-charcoal);">
  <div style="max-width: 900px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
    <div style="padding: 48px; border: 1px solid rgba(184,134,11,0.3); position: relative;" data-reveal>
      <!-- Corner accent -->
      <div style="position: absolute; top: -1px; left: -1px; width: 60px; height: 60px; border-top: 3px solid var(--color-brass-light); border-left: 3px solid var(--color-brass-light);" aria-hidden="true"></div>

      <div style="text-align: center;">
        <!-- Shield icon -->
        <div style="margin-bottom: 20px;">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true" style="display: inline-block;">
            <path d="M24 4L6 12v12c0 11.1 7.7 21.5 18 24 10.3-2.5 18-12.9 18-24V12L24 4z" stroke="var(--color-brass-light)" stroke-width="2" fill="none"/>
            <path d="M20 24l4 4 8-8" stroke="var(--color-brass-light)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

        <span class="eyebrow eyebrow-light" style="display: block; margin-bottom: 12px;">Our Promise</span>
        <h2 class="font-heading" style="color: var(--color-text-light); margin-bottom: 16px; font-size: clamp(1.5rem, 3vw, 2rem);">
          Price Lock Guarantee
        </h2>
        <p style="font-size: 1rem; color: rgba(240,237,232,0.85); line-height: 1.8; margin-bottom: 32px; max-width: 600px; margin-left: auto; margin-right: auto;">
          We lock your project price at design stage. No hidden costs. No surprises. Just honest, transparent pricing from day one.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3" style="gap: 24px; text-align: center;">
          <div style="padding: 24px;">
            <span class="font-heading" style="font-size: 1.3rem; color: var(--color-brass-light); display: block; margin-bottom: 8px;">Fixed Price</span>
            <p style="font-size: 0.85rem; color: rgba(240,237,232,0.7); line-height: 1.6;">
              Your price is locked at design sign-off — we absorb cost increases, not you.
            </p>
          </div>
          <div style="padding: 24px;">
            <span class="font-heading" style="font-size: 1.3rem; color: var(--color-brass-light); display: block; margin-bottom: 8px;">No-Change Clause</span>
            <p style="font-size: 0.85rem; color: rgba(240,237,232,0.7); line-height: 1.6;">
              Agreed scope means agreed price. Only client-requested changes affect the final cost.
            </p>
          </div>
          <div style="padding: 24px;">
            <span class="font-heading" style="font-size: 1.3rem; color: var(--color-brass-light); display: block; margin-bottom: 8px;">Full Transparency</span>
            <p style="font-size: 0.85rem; color: rgba(240,237,232,0.7); line-height: 1.6;">
              Itemised quotations, open-book accounting, and a clear variation process if you change your mind.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
