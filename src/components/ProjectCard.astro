---
interface Props {
  title: string;
  type: string;
  location: string;
  image: string;
  description?: string;
}

const { title, type, location, image, description } = Astro.props;
---

<div class="img-zoom" style="background: var(--color-charcoal); overflow: hidden;">
  <img
    src={image}
    alt={`${title} in ${location}`}
    width="600"
    height="400"
    loading="lazy"
    style="width: 100%; height: 280px; object-fit: cover; display: block;"
  />
  <div style="padding: 24px;">
    <span style="font-size: 0.68rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-brass-light); display: inline-block; margin-bottom: 8px; background: rgba(184,134,11,0.15); padding: 4px 10px;">
      {type}
    </span>
    <h3 class="font-heading" style="font-size: 1.15rem; color: var(--color-text-light); margin-bottom: 4px;">
      {title}
    </h3>
    <span style="font-size: 0.82rem; color: rgba(240,237,232,0.5); display: block;">
      {location}
    </span>
    {description && (
      <p style="font-size: 0.85rem; color: rgba(240,237,232,0.6); line-height: 1.7; margin-top: 12px;">
        {description}
      </p>
    )}
  </div>
</div>
