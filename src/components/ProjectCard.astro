---
interface Props {
  title: string;
  type: string;
  location: string;
  image: string;
  description?: string;
  value?: string;
  index?: number;
}

const { title, type, location, image, description, value, index = 0 } = Astro.props;

import { badgeColors } from '@/lib/constants';
const badgeBg = badgeColors[type] || 'rgba(184,134,11,0.9)';
---

<div class="project-card geo-cut" style="background: var(--color-charcoal); overflow: hidden;" data-project-index={index}>
  <div class="img-zoom" style="position: relative; overflow: hidden;">
    <img
      src={image}
      srcset={`${image.replace('.webp', '-400w.webp')} 400w, ${image.replace('.webp', '-800w.webp')} 800w, ${image.replace('.webp', '-1200w.webp')} 1200w`}
      sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 400px"
      alt={`${title} in ${location}`}
      width="600"
      height="400"
      loading="lazy"
      style="width: 100%; height: 280px; object-fit: cover; display: block;"
    />
    <!-- Hover overlay -->
    <div class="project-card-overlay">
      <span style={`font-size: 0.65rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-warm-white); display: inline-block; padding: 4px 10px; background: ${badgeBg}; align-self: flex-start; margin-bottom: 10px;`}>
        {type}
      </span>
      <span class="font-heading" style="font-size: 1.2rem; color: var(--color-text-light); display: block; margin-bottom: 4px;">
        {title}
      </span>
      <span style="font-size: 0.82rem; color: rgba(240,237,232,0.85); display: block; margin-bottom: 12px;">
        {value && `${value} · `}{location}
      </span>
      <span style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-brass-light);">
        View Case Study &#8594;
      </span>
    </div>
    <div class="project-card-border"></div>
  </div>
  <div style="padding: 24px;">
    <span style={`font-size: 0.65rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-warm-white); display: inline-block; margin-bottom: 8px; padding: 4px 10px; background: ${badgeBg};`}>
      {type}
    </span>
    <h3 class="font-heading" style="font-size: 1.15rem; color: var(--color-text-light); margin-bottom: 4px;">
      {title}
    </h3>
    <span style="font-size: 0.82rem; color: rgba(240,237,232,0.85); display: block;">
      {value && `${value} · `}{location}
    </span>
  </div>
</div>
