---
import { SITE } from '@/config';
---

<section style="padding: 80px 0; background: var(--color-brass); position: relative; overflow: hidden;">
  <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(184,134,11,1) 0%, rgba(212,168,67,1) 100%);" aria-hidden="true"></div>

  <div style="max-width: 800px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px); text-align: center; position: relative; z-index: 1;" data-reveal>
    <h2 class="font-heading" style="color: var(--color-warm-white); margin-bottom: 16px; font-size: clamp(2rem, 4vw, 2.8rem);">
      Let's Discuss Your Vision
    </h2>
    <p style="font-size: 1rem; color: rgba(250,250,248,0.85); margin-bottom: 32px; line-height: 1.7;">
      Every exceptional home begins with a conversation. Book a complimentary consultation — we'll visit your site, listen to your aspirations and provide honest, expert guidance with no obligation.
    </p>
    <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
      <a
        href={`tel:${SITE.phone.replace(/\s/g, '')}`}
        class="btn-primary"
        style="padding: 16px 36px; background: var(--color-charcoal); color: var(--color-text-light);"
      >
        Call {SITE.phone}
      </a>
      <a
        href="/contact/"
        class="btn-primary"
        style="padding: 16px 36px; background: transparent; border: 2px solid var(--color-warm-white); color: var(--color-warm-white);"
      >
        Start a Conversation
      </a>
    </div>
  </div>
</section>
