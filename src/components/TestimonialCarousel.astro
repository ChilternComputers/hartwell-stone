---
import { testimonials as allTestimonials } from '@/data/testimonials';

const testimonials = allTestimonials.slice(0, 4);
---

<section style="padding: 96px 0; background: var(--color-warm-white);">
  <div style="max-width: 900px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
    <div style="text-align: center; margin-bottom: 56px;" data-reveal="fade">
      <span class="eyebrow" style="display: block; margin-bottom: 12px;">Client Testimonials</span>
      <h2 class="font-heading">What Our Clients Say</h2>
    </div>

    <!-- Carousel container -->
    <div id="testimonial-carousel" style="position: relative; min-height: 220px;" data-reveal="scale">
      {testimonials.map((t, i) => (
        <div class={`testimonial-slide ${i === 0 ? 'active' : ''}`} data-slide={i}>
          <div style="text-align: center;">
            <!-- Large quote mark -->
            <span class="font-heading" style="font-size: clamp(4rem, 8vw, 6rem); color: var(--color-brass); opacity: 0.15; line-height: 1; display: block;" aria-hidden="true">&ldquo;</span>
            <!-- Quote text -->
            <p style="font-size: clamp(1.1rem, 2vw, 1.35rem); font-style: italic; color: var(--color-text-dark); line-height: 1.8; max-width: 720px; margin: -24px auto 28px; font-family: var(--font-heading); font-weight: 400;">
              {t.text}
            </p>
            <!-- Attribution -->
            <div>
              <span style="font-weight: 600; color: var(--color-charcoal); display: block; font-size: 0.95rem;">
                {t.name}
              </span>
              <span style="font-size: 0.8rem; color: rgba(44,44,46,0.55);">
                {t.project} — {t.location}
              </span>
            </div>
          </div>
        </div>
      ))}

      <!-- Controls: dots + pause -->
      <div style="display: flex; justify-content: center; align-items: center; gap: 10px; margin-top: 32px;" id="testimonial-dots">
        {testimonials.map((_, i) => (
          <button
            class={`testimonial-dot ${i === 0 ? 'active' : ''}`}
            data-dot={i}
            aria-label={`Show testimonial ${i + 1}`}
          ></button>
        ))}
        <button
          id="carousel-pause"
          aria-label="Pause testimonial carousel"
          style="width: 44px; height: 44px; background: none; border: 1px solid var(--color-border); border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; margin-left: 8px; font-size: 0.85rem; color: var(--color-brass); transition: border-color 0.3s ease;"
        >
          ❚❚
        </button>
      </div>
    </div>

    <div style="text-align: center; margin-top: 40px;" data-reveal="up">
      <a href="/testimonials/" class="btn-primary btn-outline" style="padding: 14px 32px;">
        Read More Reviews
      </a>
    </div>
  </div>
</section>

<!-- Static fallback for reduced motion -->
<noscript>
  <style>
    .testimonial-slide { position: relative !important; opacity: 1 !important; margin-bottom: 32px; }
    #testimonial-dots { display: none !important; }
  </style>
</noscript>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const slides = document.querySelectorAll('.testimonial-slide');
  const dots = document.querySelectorAll('.testimonial-dot');
  let current = 0;
  let interval: ReturnType<typeof setInterval>;

  if (prefersReducedMotion) {
    // Show all slides statically
    slides.forEach((s) => {
      (s as HTMLElement).style.position = 'relative';
      (s as HTMLElement).style.opacity = '1';
      (s as HTMLElement).style.marginBottom = '48px';
    });
    const dotsContainer = document.getElementById('testimonial-dots');
    if (dotsContainer) dotsContainer.style.display = 'none';
  } else {
    const goTo = (index: number) => {
      slides.forEach((s, i) => {
        s.classList.toggle('active', i === index);
      });
      dots.forEach((d, i) => {
        d.classList.toggle('active', i === index);
      });
      current = index;
    };

    // Click on dots
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const i = parseInt(dot.getAttribute('data-dot') || '0');
        goTo(i);
        clearInterval(interval);
        startAuto();
      });
    });

    // Auto-rotate
    const startAuto = () => {
      interval = setInterval(() => {
        goTo((current + 1) % slides.length);
      }, 5000);
    };
    startAuto();

    // Pause on hover
    const carousel = document.getElementById('testimonial-carousel');
    carousel?.addEventListener('mouseenter', () => clearInterval(interval));
    carousel?.addEventListener('mouseleave', () => { if (!paused) startAuto(); });

    // Pause button for keyboard users
    let paused = false;
    const pauseBtn = document.getElementById('carousel-pause');
    pauseBtn?.addEventListener('click', () => {
      paused = !paused;
      if (paused) {
        clearInterval(interval);
        pauseBtn.textContent = '▶';
        pauseBtn.setAttribute('aria-label', 'Play testimonial carousel');
      } else {
        startAuto();
        pauseBtn.textContent = '❚❚';
        pauseBtn.setAttribute('aria-label', 'Pause testimonial carousel');
      }
    });
  }
</script>
