---
---

<div id="quote-form" style="max-width: 640px; margin: 0 auto;">
  <!-- Step indicators -->
  <div style="display: flex; justify-content: center; gap: 8px; margin-bottom: 40px;">
    <div class="step-dot" data-step-dot="1" style="width: 44px; height: 44px; border-radius: 50%; background: var(--color-brass); color: var(--color-warm-white); display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 600;">1</div>
    <div style="width: 40px; height: 2px; background: var(--color-border); align-self: center;" aria-hidden="true"></div>
    <div class="step-dot" data-step-dot="2" style="width: 44px; height: 44px; border-radius: 50%; background: var(--color-border); color: var(--color-text-dark); display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 600;">2</div>
    <div style="width: 40px; height: 2px; background: var(--color-border); align-self: center;" aria-hidden="true"></div>
    <div class="step-dot" data-step-dot="3" style="width: 44px; height: 44px; border-radius: 50%; background: var(--color-border); color: var(--color-text-dark); display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 600;">3</div>
  </div>

  <p style="font-size: 0.78rem; color: var(--color-text-muted); text-align: center; margin-bottom: 24px;">Fields marked with <span class="text-red-600">*</span> are required</p>
  <form id="multi-step-form" novalidate>
    <!-- Step 1: Project Type -->
    <fieldset id="step-1" style="border: none; padding: 0; margin: 0;">
      <legend class="font-heading" style="font-size: 1.5rem; color: var(--color-charcoal); margin-bottom: 24px; display: block;">What type of project are you considering?</legend>

      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;">
        {['Bespoke New Build', 'Extension', 'Heritage / Listed Building', 'Whole-House Renovation', 'Barn / Heritage Conversion', 'Project Management'].map((type) => (
          <label style="display: flex; align-items: center; gap: 12px; padding: 16px; border: 2px solid var(--color-border); cursor: pointer; transition: all 0.3s ease; background: var(--color-warm-white);">
            <input type="radio" name="project-type" value={type} required style="accent-color: var(--color-brass); width: 18px; height: 18px;" />
            <span style="font-size: 0.9rem; font-weight: 500; color: var(--color-text-dark);">{type}</span>
          </label>
        ))}
      </div>

      <div style="margin-top: 32px; text-align: right;">
        <button type="button" class="btn-primary btn-fill" style="padding: 14px 32px;" data-next="2">
          Next Step
        </button>
      </div>
    </fieldset>

    <!-- Step 2: Project Details -->
    <fieldset id="step-2" style="border: none; padding: 0; margin: 0; display: none;">
      <legend class="font-heading" style="font-size: 1.5rem; color: var(--color-charcoal); margin-bottom: 24px; display: block;">Tell us about your project</legend>

      <div style="display: flex; flex-direction: column; gap: 20px;">
        <div>
          <label for="project-description" style="display: block; font-size: 0.85rem; font-weight: 500; color: var(--color-text-dark); margin-bottom: 6px;">
            Describe your project
          </label>
          <textarea
            id="project-description"
            name="description"
            rows="4"
            placeholder="E.g., We've recently purchased a Grade II listed farmhouse and would like to discuss a sympathetic restoration with a contemporary rear extension..."
            style="width: 100%; padding: 12px 16px; border: 2px solid var(--color-border); background: var(--color-warm-white); font-family: var(--font-body); font-size: 0.9rem; color: var(--color-text-dark); resize: vertical;"
          ></textarea>
        </div>

        <div>
          <label for="budget" style="display: block; font-size: 0.85rem; font-weight: 500; color: var(--color-text-dark); margin-bottom: 6px;">
            Anticipated budget range
          </label>
          <select
            id="budget"
            name="budget"
            style="width: 100%; padding: 12px 16px; border: 2px solid var(--color-border); background: var(--color-warm-white); font-family: var(--font-body); font-size: 0.9rem; color: var(--color-text-dark);"
          >
            <option value="">Select a range</option>
            <option value="60-150k">£60,000 – £150,000</option>
            <option value="150-250k">£150,000 – £250,000</option>
            <option value="250-500k">£250,000 – £500,000</option>
            <option value="500k-1m">£500,000 – £1,000,000</option>
            <option value="1m-plus">£1,000,000+</option>
            <option value="unsure">Not yet determined</option>
          </select>
        </div>

        <div>
          <label for="timeline" style="display: block; font-size: 0.85rem; font-weight: 500; color: var(--color-text-dark); margin-bottom: 6px;">
            When would you like to start?
          </label>
          <select
            id="timeline"
            name="timeline"
            style="width: 100%; padding: 12px 16px; border: 2px solid var(--color-border); background: var(--color-warm-white); font-family: var(--font-body); font-size: 0.9rem; color: var(--color-text-dark);"
          >
            <option value="">Select timing</option>
            <option value="asap">As soon as possible</option>
            <option value="1-3-months">Within 1–3 months</option>
            <option value="3-6-months">Within 3–6 months</option>
            <option value="6-plus">6+ months</option>
            <option value="just-planning">Early planning stage</option>
          </select>
        </div>
      </div>

      <div style="margin-top: 32px; display: flex; justify-content: space-between;">
        <button type="button" class="btn-primary btn-outline" style="padding: 14px 32px;" data-prev="1">
          Back
        </button>
        <button type="button" class="btn-primary btn-fill" style="padding: 14px 32px;" data-next="3">
          Next Step
        </button>
      </div>
    </fieldset>

    <!-- Step 3: Contact Info -->
    <fieldset id="step-3" style="border: none; padding: 0; margin: 0; display: none;">
      <legend class="font-heading" style="font-size: 1.5rem; color: var(--color-charcoal); margin-bottom: 24px; display: block;">Your contact details</legend>

      <div style="display: flex; flex-direction: column; gap: 20px;">
        <div>
          <label for="contact-name" style="display: block; font-size: 0.85rem; font-weight: 500; color: var(--color-text-dark); margin-bottom: 6px;">
            Full name <span class="text-red-600">*</span>
          </label>
          <input
            type="text"
            id="contact-name"
            name="name"
            required
            aria-required="true"
            aria-describedby="contact-name-error"
            autocomplete="name"
            placeholder="Your full name"
            style="width: 100%; padding: 12px 16px; border: 2px solid var(--color-border); background: var(--color-warm-white); font-family: var(--font-body); font-size: 0.9rem; color: var(--color-text-dark);"
          />
          <span id="contact-name-error" role="alert" style="font-size: 0.78rem; color: var(--color-error); display: none; margin-top: 4px;"></span>
        </div>

        <div>
          <label for="contact-email" style="display: block; font-size: 0.85rem; font-weight: 500; color: var(--color-text-dark); margin-bottom: 6px;">
            Email address <span class="text-red-600">*</span>
          </label>
          <input
            type="email"
            id="contact-email"
            name="email"
            required
            aria-required="true"
            aria-describedby="contact-email-error"
            autocomplete="email"
            placeholder="you@example.com"
            style="width: 100%; padding: 12px 16px; border: 2px solid var(--color-border); background: var(--color-warm-white); font-family: var(--font-body); font-size: 0.9rem; color: var(--color-text-dark);"
          />
          <span id="contact-email-error" role="alert" style="font-size: 0.78rem; color: var(--color-error); display: none; margin-top: 4px;"></span>
        </div>

        <div>
          <label for="contact-phone" style="display: block; font-size: 0.85rem; font-weight: 500; color: var(--color-text-dark); margin-bottom: 6px;">
            Phone number <span class="text-red-600">*</span>
          </label>
          <input
            type="tel"
            id="contact-phone"
            name="phone"
            required
            aria-required="true"
            aria-describedby="contact-phone-error"
            autocomplete="tel"
            placeholder="01234 567 890"
            style="width: 100%; padding: 12px 16px; border: 2px solid var(--color-border); background: var(--color-warm-white); font-family: var(--font-body); font-size: 0.9rem; color: var(--color-text-dark);"
          />
          <span id="contact-phone-error" role="alert" style="font-size: 0.78rem; color: var(--color-error); display: none; margin-top: 4px;"></span>
        </div>

        <div>
          <label for="contact-postcode" style="display: block; font-size: 0.85rem; font-weight: 500; color: var(--color-text-dark); margin-bottom: 6px;">
            Property postcode
          </label>
          <input
            type="text"
            id="contact-postcode"
            name="postcode"
            autocomplete="postal-code"
            placeholder="CM1 1HL"
            style="width: 100%; padding: 12px 16px; border: 2px solid var(--color-border); background: var(--color-warm-white); font-family: var(--font-body); font-size: 0.9rem; color: var(--color-text-dark);"
          />
        </div>
      </div>

      <div style="position: absolute; left: -9999px;" aria-hidden="true">
        <label for="website">Website</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <div style="margin-top: 32px; display: flex; justify-content: space-between;">
        <button type="button" class="btn-primary btn-outline" style="padding: 14px 32px;" data-prev="2">
          Back
        </button>
        <button type="submit" class="btn-primary btn-fill" style="padding: 14px 32px;">
          Submit Enquiry
        </button>
      </div>
    </fieldset>

    <!-- Success message -->
    <div id="form-success" role="status" aria-live="polite" style="display: none; text-align: center; padding: 48px 24px;">
      <span style="font-size: 3rem; display: block; margin-bottom: 16px;" aria-hidden="true">&#10003;</span>
      <h3 class="font-heading" style="font-size: 1.5rem; color: var(--color-charcoal); margin-bottom: 12px;">Thank You</h3>
      <p style="font-size: 0.95rem; color: var(--color-text-secondary); line-height: 1.7;">
        We've received your project enquiry. A member of our team will be in touch within 24 hours to discuss your project in detail.
      </p>
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('multi-step-form') as HTMLFormElement;
  const steps = [
    document.getElementById('step-1'),
    document.getElementById('step-2'),
    document.getElementById('step-3'),
  ];
  const dots = document.querySelectorAll('.step-dot');
  const successMsg = document.getElementById('form-success');

  function showStep(n: number) {
    steps.forEach((s, i) => {
      if (s) s.style.display = i === n - 1 ? 'block' : 'none';
    });
    dots.forEach((d, i) => {
      const el = d as HTMLElement;
      if (i < n) {
        el.style.background = 'var(--color-brass)';
        el.style.color = 'var(--color-warm-white)';
      } else {
        el.style.background = 'var(--color-border)';
        el.style.color = 'var(--color-text-dark)';
      }
    });
    // Focus management
    const target = steps[n - 1]?.querySelector('legend, input, select, textarea') as HTMLElement;
    if (target) target.focus();
  }

  document.querySelectorAll('[data-next]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = parseInt(btn.getAttribute('data-next') || '1');
      // Validate Step 1: require project type selection
      if (next === 2) {
        const selected = document.querySelector<HTMLInputElement>('input[name="project-type"]:checked');
        if (!selected) {
          const legend = document.querySelector('#step-1 legend') as HTMLElement;
          if (legend) {
            legend.style.color = 'var(--color-error)';
            legend.textContent = 'Please select a project type';
            setTimeout(() => {
              legend.style.color = 'var(--color-charcoal)';
              legend.textContent = 'What type of project are you considering?';
            }, 3000);
          }
          return;
        }
      }
      showStep(next);
    });
  });

  document.querySelectorAll('[data-prev]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const prev = parseInt(btn.getAttribute('data-prev') || '1');
      showStep(prev);
    });
  });

  function showError(id: string, msg: string) {
    const el = document.getElementById(id);
    const errEl = document.getElementById(id + '-error');
    if (el && errEl) {
      el.setAttribute('aria-invalid', 'true');
      el.style.borderColor = 'var(--color-error)';
      errEl.textContent = msg;
      errEl.style.display = 'block';
    }
  }

  function clearErrors() {
    ['contact-name', 'contact-email', 'contact-phone'].forEach((id) => {
      const el = document.getElementById(id);
      const errEl = document.getElementById(id + '-error');
      if (el) {
        el.removeAttribute('aria-invalid');
        el.style.borderColor = '';
      }
      if (errEl) {
        errEl.textContent = '';
        errEl.style.display = 'none';
      }
    });
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if ((document.getElementById('website') as HTMLInputElement)?.value) return;
    clearErrors();

    const name = (document.getElementById('contact-name') as HTMLInputElement)?.value.trim();
    const email = (document.getElementById('contact-email') as HTMLInputElement)?.value.trim();
    const phone = (document.getElementById('contact-phone') as HTMLInputElement)?.value.trim();
    let valid = true;

    if (!name) { showError('contact-name', 'Please enter your full name.'); valid = false; }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showError('contact-email', 'Please enter a valid email address.'); valid = false; }
    if (!phone) { showError('contact-phone', 'Please enter your phone number.'); valid = false; }

    if (!valid) {
      const firstInvalid = form.querySelector('[aria-invalid="true"]') as HTMLElement;
      firstInvalid?.focus();
      return;
    }

    // Demo — just show success
    form.style.display = 'none';
    if (successMsg) successMsg.style.display = 'block';
    dots.forEach((d) => {
      (d as HTMLElement).style.background = 'var(--color-brass)';
      (d as HTMLElement).style.color = 'var(--color-warm-white)';
    });
  });
</script>
