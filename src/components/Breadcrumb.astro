---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" style="margin-bottom: 12px;">
  <ol style="list-style: none; padding: 0; margin: 0; display: flex; justify-content: center; gap: 8px; flex-wrap: wrap;">
    {items.map((item, i) => (
      <li aria-current={i === items.length - 1 ? 'page' : undefined}>
        {item.href ? (
          <>
            <a href={item.href} style="font-size: 0.78rem; color: rgba(240,237,232,0.85); transition: color 0.3s ease;" class="hover:text-text-light">{item.label}</a>
            <span style="color: rgba(240,237,232,0.4); margin-left: 8px;" aria-hidden="true">/</span>
          </>
        ) : (
          <span style="font-size: 0.78rem; color: var(--color-brass-light);">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
