---
import { SITE } from '@/config';

const currentPath = Astro.url.pathname;

const navLinks = [
  { label: 'Services', href: '/services/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Gallery', href: '/gallery/' },
  { label: 'About', href: '/about/' },
  { label: 'Insights', href: '/insights/' },
  { label: 'Testimonials', href: '/testimonials/' },
  { label: 'Contact', href: '/contact/' },
];
---

<header
  id="navbar"
  role="banner"
  style="position: fixed; top: 0; left: 0; right: 0; z-index: 50; transition: transform 0.5s cubic-bezier(0.445, 0.05, 0.55, 0.95), background-color 0.5s ease, backdrop-filter 0.5s ease;"
>
  <div style="padding: 0 clamp(24px, 4vw, 48px);">
    <nav
      aria-label="Main navigation"
      style="max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; height: 80px;"
      id="nav-inner"
    >
      <!-- Logo with brand mark -->
      <a href="/" aria-label="H&S Hartwell & Stone — Home" style="z-index: 10; text-decoration: none; display: flex; align-items: center; gap: 14px;">
        <!-- CSS Monogram -->
        <div style="width: 38px; height: 38px; border: 1.5px solid var(--color-brass-light); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: border-color 0.5s ease;" id="logo-mark">
          <span class="font-heading" style="font-size: 0.85rem; letter-spacing: 0.06em; color: var(--color-brass-light); transition: color 0.5s ease; line-height: 1;" id="logo-mono">H&S</span>
        </div>
        <span
          class="font-heading"
          style="font-size: 1.4rem; letter-spacing: 0.02em; font-weight: 400; color: var(--color-text-light); transition: color 0.5s ease; line-height: 1;"
          id="logo-text"
        >Hartwell & Stone</span>
      </a>

      <!-- Desktop Nav -->
      <ul
        class="hidden lg:flex"
        style="list-style: none; margin: 0; padding: 0; gap: 36px; align-items: center;"
      >
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-link nav-link-light font-body"
              style="font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 500; color: var(--color-text-light); transition: color 0.5s ease;"
              aria-current={currentPath === link.href ? 'page' : undefined}
              data-nav-link
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Right: Phone + Hamburger -->
      <div style="display: flex; align-items: center; gap: 20px; z-index: 10;">
        <a
          href={`tel:${SITE.phone.replace(/\s/g, '')}`}
          class="hidden lg:inline-flex btn-primary btn-outline-light"
          style="padding: 10px 24px;"
          id="phone-btn"
          aria-label={`Call us on ${SITE.phone}`}
        >
          {SITE.phone}
        </a>

        <!-- Hamburger -->
        <button
          id="menu-toggle"
          class="lg:hidden"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          style="background: none; border: none; cursor: pointer; padding: 10px; z-index: 10; position: relative; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;"
        >
          <span style="position: absolute; left: 6px; width: 32px; height: 2px; background: var(--color-text-light); transition: all 0.4s ease; top: 12px;" class="hamburger-line" id="ham-1"></span>
          <span style="position: absolute; left: 6px; width: 22px; height: 2px; background: var(--color-text-light); transition: all 0.4s ease; top: 20px;" class="hamburger-line" id="ham-2"></span>
          <span style="position: absolute; left: 6px; width: 27px; height: 2px; background: var(--color-text-light); transition: all 0.4s ease; top: 28px;" class="hamburger-line" id="ham-3"></span>
        </button>
      </div>
    </nav>
  </div>
</header>

<!-- Mobile Menu -->
<div
  id="mobile-menu"
  role="dialog"
  aria-label="Mobile navigation"
  style="display: none; position: fixed; inset: 0; z-index: 45; background: var(--color-charcoal);"
>
  <nav
    aria-label="Mobile navigation"
    style="display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100%; gap: 32px;"
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="font-heading"
        style="font-size: 2rem; color: var(--color-text-light); text-decoration: none; transition: color 0.3s ease;"
        aria-current={currentPath === link.href ? 'page' : undefined}
      >
        {link.label}
      </a>
    ))}
    <div style="margin-top: 16px;">
      <a
        href={`tel:${SITE.phone.replace(/\s/g, '')}`}
        class="btn-primary btn-fill"
        style="padding: 14px 32px;"
      >
        {SITE.phone}
      </a>
    </div>
  </nav>
</div>

<script>
  const navbar = document.getElementById('navbar');
  const logoText = document.getElementById('logo-text');
  const phoneBtn = document.getElementById('phone-btn');
  const navLinksEls = document.querySelectorAll('[data-nav-link]');
  const hamLines = document.querySelectorAll('.hamburger-line');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const h1 = document.getElementById('ham-1');
  const h2 = document.getElementById('ham-2');
  const h3 = document.getElementById('ham-3');
  let lastScroll = 0;
  let ticking = false;
  let scrolled = false;
  let menuOpen = false;

  function updateNavbar() {
    const y = window.scrollY;

    if (!navbar || !logoText) return;

    if (y > 60 && !scrolled) {
      scrolled = true;
      navbar.style.backgroundColor = 'rgba(26, 29, 35, 0.95)';
      navbar.style.backdropFilter = 'blur(20px)';
      navbar.style.setProperty('-webkit-backdrop-filter', 'blur(20px)');
    } else if (y <= 60 && scrolled) {
      scrolled = false;
      navbar.style.backgroundColor = 'transparent';
      navbar.style.backdropFilter = 'none';
      navbar.style.setProperty('-webkit-backdrop-filter', 'none');
    }

    // Hide on scroll down, show on scroll up
    if (y > lastScroll && y > 300 && !menuOpen) {
      navbar.style.transform = 'translateY(-100%)';
    } else {
      navbar.style.transform = 'translateY(0)';
    }

    lastScroll = y;
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(updateNavbar);
      ticking = true;
    }
  }, { passive: true });

  // Mobile menu toggle
  function toggleMenu() {
    menuOpen = !menuOpen;
    if (!mobileMenu || !menuToggle) return;

    if (menuOpen) {
      mobileMenu.style.display = 'block';
      mobileMenu.setAttribute('aria-modal', 'true');
      menuToggle.setAttribute('aria-expanded', 'true');
      menuToggle.setAttribute('aria-label', 'Close menu');
      document.body.style.overflow = 'hidden';
      // Focus first menu link
      const firstLink = mobileMenu.querySelector('a') as HTMLElement;
      if (firstLink) setTimeout(() => firstLink.focus(), 100);

      // X animation
      if (h1) { h1.style.top = '12px'; h1.style.transform = 'rotate(45deg)'; }
      if (h2) { h2.style.opacity = '0'; }
      if (h3) { h3.style.top = '12px'; h3.style.transform = 'rotate(-45deg)'; h3.style.width = '32px'; }
    } else {
      mobileMenu.style.display = 'none';
      mobileMenu.removeAttribute('aria-modal');
      menuToggle.setAttribute('aria-expanded', 'false');
      menuToggle.setAttribute('aria-label', 'Open menu');
      document.body.style.overflow = '';
      menuToggle.focus();

      if (h1) { h1.style.top = '12px'; h1.style.transform = 'none'; }
      if (h2) { h2.style.opacity = '1'; }
      if (h3) { h3.style.top = '28px'; h3.style.transform = 'none'; h3.style.width = '27px'; }
    }
  }

  menuToggle?.addEventListener('click', toggleMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuOpen) {
      toggleMenu();
    }
  });

  // Focus trap for mobile menu
  mobileMenu?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const focusable = mobileMenu.querySelectorAll<HTMLElement>('a[href], button');
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  updateNavbar();
</script>
