---
import { reviewPlatforms, totalReviewCount } from '@/data/reviews';
import { SITE } from '@/config';
---

<section style="padding: 80px 0; background: var(--color-stone);">
  <div style="max-width: 1000px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
    <!-- Heading -->
    <div style="text-align: center; margin-bottom: 48px;" data-reveal>
      <span class="eyebrow" style="display: block; margin-bottom: 12px;">Verified Reviews</span>
      <h2 class="font-heading">Trusted Across Every Platform</h2>
      <p style="font-size: 1rem; color: var(--color-text-secondary); margin-top: 12px;">
        {SITE.reviews.rating}/5 average from {SITE.reviews.count} reviews across {reviewPlatforms.length} platforms
      </p>
    </div>

    <!-- Platform cards -->
    <div class="grid grid-cols-1 md:grid-cols-3" style="gap: 24px;" data-stagger-parent>
      {reviewPlatforms.map((platform) => (
        <a
          href={platform.url}
          target="_blank"
          rel="noopener noreferrer"
          style="padding: 32px; background: var(--color-warm-white); border: 1px solid var(--color-border); text-decoration: none; color: inherit; text-align: center; transition: border-color 0.3s ease, box-shadow 0.3s ease; display: block;"
          data-stagger-child
        >
          <!-- Platform icon -->
          <div style="margin-bottom: 16px; display: flex; justify-content: center;" set:html={platform.icon} />

          <!-- Platform name -->
          <h3 style="font-family: var(--font-body); font-size: 1rem; font-weight: 600; color: var(--color-charcoal); margin-bottom: 12px;">
            {platform.name}
          </h3>

          <!-- Stars -->
          <div style="color: var(--color-brass-dark); font-size: 1.1rem; letter-spacing: 2px; margin-bottom: 8px;" aria-hidden="true">
            {'&#9733;'.repeat(Math.floor(platform.ratingOutOf === 10 ? platform.rating / 2 : platform.rating))}
          </div>

          <!-- Rating -->
          <span class="font-heading" style="font-size: 1.8rem; color: var(--color-charcoal); display: block; margin-bottom: 4px;">
            {platform.rating}<span style="font-size: 0.9rem; color: var(--color-text-muted);">/{platform.ratingOutOf}</span>
          </span>

          <!-- Review count -->
          <span style="font-size: 0.82rem; color: var(--color-text-muted);">
            {platform.reviewCount} reviews
          </span>

          <!-- Link -->
          <span style="display: block; margin-top: 16px; font-size: 0.78rem; font-weight: 600; color: var(--color-brass-dark);">
            Read reviews &rarr;
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  a[data-stagger-child]:hover {
    border-color: var(--color-brass) !important;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
  }
</style>
