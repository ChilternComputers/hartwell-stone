---
import { projects } from '@/data/projects';
import VideoPlayer from '@/components/VideoPlayer.astro';

// Get projects that have videos
const videoProjects = projects.filter((p) => p.video);
const featured = videoProjects[0];
---

{featured && (
  <section style="padding: 96px 0; background: var(--color-charcoal);">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
      <div style="text-align: center; margin-bottom: 48px;" data-reveal>
        <span class="eyebrow eyebrow-light" style="display: block; margin-bottom: 12px;">See Our Work</span>
        <h2 class="font-heading" style="color: var(--color-text-light);">Watch Our Craftsmanship</h2>
        <p style="font-size: 0.95rem; color: rgba(240,237,232,0.75); margin-top: 12px; max-width: 600px; margin-left: auto; margin-right: auto;">
          See the quality and attention to detail that goes into every Hartwell & Stone project.
        </p>
      </div>

      <div style="max-width: 900px; margin: 0 auto;">
        <VideoPlayer
          src={featured.video!}
          poster={featured.image}
          title={featured.title}
        />
        <div style="margin-top: 20px; text-align: center;" data-reveal>
          <h3 class="font-heading" style="font-size: 1.2rem; color: var(--color-text-light); margin-bottom: 8px;">
            {featured.title}
          </h3>
          <p style="font-size: 0.88rem; color: rgba(240,237,232,0.75); margin-bottom: 16px;">
            {featured.type} · {featured.location} · {featured.value}
          </p>
          <a href={`/projects/${featured.slug}/`} style="font-size: 0.82rem; font-weight: 600; color: var(--color-brass-light); text-decoration: none;">
            View Full Case Study &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>
)}
