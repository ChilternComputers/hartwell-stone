---
import { SITE } from '@/config';
---

<footer role="contentinfo" style="background: var(--color-charcoal);">
  <div style="max-width: 1200px; margin: 0 auto; padding: 64px clamp(24px, 4vw, 48px) 32px;">

    <!-- 4-column grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4" style="gap: 40px; margin-bottom: 48px;">

      <!-- Company -->
      <div>
        <span class="font-heading" style="font-size: 1.3rem; color: var(--color-text-light); display: block; margin-bottom: 16px;">
          Hartwell & Stone
        </span>
        <p style="font-size: 0.88rem; line-height: 1.7; color: rgba(240,237,232,0.6); margin-bottom: 16px;">
          Premium residential construction in Essex. Building excellence since 1987.
        </p>
        <div style="display: flex; gap: 12px;">
          <span style="font-size: 0.7rem; color: var(--color-brass); font-weight: 600; letter-spacing: 0.05em;">{SITE.accreditations.fmb}</span>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h3 style="font-size: 0.8rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-light); margin-bottom: 20px; font-family: var(--font-body);">Services</h3>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px;">
          <li><a href="/services/#extensions" style="font-size: 0.85rem; color: rgba(240,237,232,0.55); transition: color 0.3s ease;" class="hover:text-text-light">Extensions</a></li>
          <li><a href="/services/#lofts" style="font-size: 0.85rem; color: rgba(240,237,232,0.55); transition: color 0.3s ease;" class="hover:text-text-light">Loft Conversions</a></li>
          <li><a href="/services/#renovations" style="font-size: 0.85rem; color: rgba(240,237,232,0.55); transition: color 0.3s ease;" class="hover:text-text-light">Renovations</a></li>
          <li><a href="/services/#new-builds" style="font-size: 0.85rem; color: rgba(240,237,232,0.55); transition: color 0.3s ease;" class="hover:text-text-light">New Builds</a></li>
          <li><a href="/services/#kitchens" style="font-size: 0.85rem; color: rgba(240,237,232,0.55); transition: color 0.3s ease;" class="hover:text-text-light">Kitchens</a></li>
          <li><a href="/services/#bathrooms" style="font-size: 0.85rem; color: rgba(240,237,232,0.55); transition: color 0.3s ease;" class="hover:text-text-light">Bathrooms</a></li>
        </ul>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 style="font-size: 0.8rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-light); margin-bottom: 20px; font-family: var(--font-body);">Company</h3>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px;">
          <li><a href="/about/" style="font-size: 0.85rem; color: rgba(240,237,232,0.55); transition: color 0.3s ease;" class="hover:text-text-light">About Us</a></li>
          <li><a href="/projects/" style="font-size: 0.85rem; color: rgba(240,237,232,0.55); transition: color 0.3s ease;" class="hover:text-text-light">Our Projects</a></li>
          <li><a href="/testimonials/" style="font-size: 0.85rem; color: rgba(240,237,232,0.55); transition: color 0.3s ease;" class="hover:text-text-light">Testimonials</a></li>
          <li><a href="/areas/" style="font-size: 0.85rem; color: rgba(240,237,232,0.55); transition: color 0.3s ease;" class="hover:text-text-light">Service Areas</a></li>
          <li><a href="/contact/" style="font-size: 0.85rem; color: rgba(240,237,232,0.55); transition: color 0.3s ease;" class="hover:text-text-light">Contact</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 style="font-size: 0.8rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-light); margin-bottom: 20px; font-family: var(--font-body);">Contact</h3>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} style="font-size: 0.88rem; color: var(--color-brass-light); font-weight: 500; transition: color 0.3s ease;">
            {SITE.phone}
          </a>
          <a href={`mailto:${SITE.email}`} style="font-size: 0.85rem; color: rgba(240,237,232,0.55); transition: color 0.3s ease;" class="hover:text-text-light">
            {SITE.email}
          </a>
          <p style="font-size: 0.85rem; color: rgba(240,237,232,0.55); line-height: 1.6;">
            {SITE.address.street}<br />
            {SITE.address.area}, {SITE.address.city}<br />
            {SITE.address.postcode}
          </p>
          <p style="font-size: 0.8rem; color: rgba(240,237,232,0.45); line-height: 1.6;">
            {SITE.hours.weekday}<br />
            {SITE.hours.saturday}<br />
            {SITE.hours.sunday}
          </p>
        </div>
      </div>
    </div>

    <!-- Accreditations -->
    <div style="border-top: 1px solid rgba(240,237,232,0.08); padding-top: 24px; margin-bottom: 24px;">
      <div style="display: flex; justify-content: center; flex-wrap: wrap; gap: 24px; align-items: center;">
        <span style="font-size: 0.7rem; color: rgba(240,237,232,0.4); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;">FMB Member</span>
        <span style="font-size: 0.7rem; color: rgba(240,237,232,0.4); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;">TrustMark</span>
        <span style="font-size: 0.7rem; color: rgba(240,237,232,0.4); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;">Checkatrade</span>
        <span style="font-size: 0.7rem; color: rgba(240,237,232,0.4); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;">LABC</span>
        <span style="font-size: 0.7rem; color: rgba(240,237,232,0.4); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;">Which? Trusted Trader</span>
      </div>
    </div>

    <!-- Bottom bar -->
    <div style="border-top: 1px solid rgba(240,237,232,0.06); padding-top: 20px; display: flex; justify-content: center; flex-wrap: wrap; gap: 8px 24px;">
      <span style="font-size: 0.72rem; color: rgba(240,237,232,0.4);">
        &copy; {new Date().getFullYear()} {SITE.legalName}. All rights reserved.
      </span>
      <a href="/privacy/" style="font-size: 0.72rem; color: rgba(240,237,232,0.4); transition: color 0.3s ease;" class="hover:text-text-light">Privacy Policy</a>
      <a href="/terms/" style="font-size: 0.72rem; color: rgba(240,237,232,0.4); transition: color 0.3s ease;" class="hover:text-text-light">Terms</a>
    </div>
  </div>
</footer>
