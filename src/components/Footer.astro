---
import { SITE } from '@/config';
---

<footer role="contentinfo" style="background: var(--color-charcoal);">
  <div style="max-width: 1200px; margin: 0 auto; padding: 120px clamp(24px, 4vw, 48px) 32px;">

    <!-- Large company name as hero element -->
    <div style="text-align: center; margin-bottom: 56px;">
      <span class="font-heading" style="font-size: clamp(2.2rem, 5vw, 3.5rem); color: var(--color-text-light); display: block; line-height: 1.1;">
        Hartwell & Stone
      </span>
      <p style="font-size: 0.92rem; color: rgba(240,237,232,0.6); margin-top: 12px; font-style: italic;">
        Building Britain's Finest Homes Since 1987
      </p>
      <div class="line-accent" style="margin: 24px auto 0;" aria-hidden="true"></div>
    </div>

    <!-- 3-column minimal layout -->
    <div class="grid grid-cols-1 md:grid-cols-3" style="gap: 40px; margin-bottom: 56px;">

      <!-- Navigation -->
      <div style="text-align: center;">
        <h3 style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(240,237,232,0.6); margin-bottom: 20px; font-family: var(--font-body);">Navigate</h3>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px;">
          <li><a href="/services/" style="font-size: 0.88rem; color: rgba(240,237,232,0.6); transition: color 0.3s ease;" class="hover:text-text-light">Services</a></li>
          <li><a href="/projects/" style="font-size: 0.88rem; color: rgba(240,237,232,0.6); transition: color 0.3s ease;" class="hover:text-text-light">Projects</a></li>
          <li><a href="/gallery/" style="font-size: 0.88rem; color: rgba(240,237,232,0.6); transition: color 0.3s ease;" class="hover:text-text-light">Gallery</a></li>
          <li><a href="/about/" style="font-size: 0.88rem; color: rgba(240,237,232,0.6); transition: color 0.3s ease;" class="hover:text-text-light">About</a></li>
          <li><a href="/testimonials/" style="font-size: 0.88rem; color: rgba(240,237,232,0.6); transition: color 0.3s ease;" class="hover:text-text-light">Testimonials</a></li>
          <li><a href="/areas/" style="font-size: 0.88rem; color: rgba(240,237,232,0.6); transition: color 0.3s ease;" class="hover:text-text-light">Areas</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div style="text-align: center;">
        <h3 style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(240,237,232,0.6); margin-bottom: 20px; font-family: var(--font-body);">Contact</h3>
        <div style="display: flex; flex-direction: column; gap: 10px;">
          <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} style="font-size: 0.95rem; color: var(--color-brass-light); font-weight: 500;">
            {SITE.phone}
          </a>
          <a href={`mailto:${SITE.email}`} style="font-size: 0.88rem; color: rgba(240,237,232,0.6); transition: color 0.3s ease;" class="hover:text-text-light">
            {SITE.email}
          </a>
          <p style="font-size: 0.85rem; color: rgba(240,237,232,0.5); line-height: 1.6;">
            {SITE.address.street}, {SITE.address.area}<br />
            {SITE.address.city} {SITE.address.postcode}
          </p>
        </div>
      </div>

      <!-- Social -->
      <div style="text-align: center;">
        <h3 style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(240,237,232,0.6); margin-bottom: 20px; font-family: var(--font-body);">Connect</h3>
        <div style="display: flex; flex-direction: column; gap: 10px;">
          <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer" style="font-size: 0.88rem; color: rgba(240,237,232,0.6); transition: color 0.3s ease;" class="hover:text-text-light">
            Facebook
          </a>
          <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" style="font-size: 0.88rem; color: rgba(240,237,232,0.6); transition: color 0.3s ease;" class="hover:text-text-light">
            Instagram
          </a>
          <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener noreferrer" style="font-size: 0.88rem; color: rgba(240,237,232,0.6); transition: color 0.3s ease;" class="hover:text-text-light">
            WhatsApp
          </a>
        </div>
      </div>
    </div>

    <!-- Accreditations — styled badges -->
    <div style="border-top: 1px solid rgba(240,237,232,0.08); padding-top: 28px; margin-bottom: 24px;">
      <div style="display: flex; justify-content: center; flex-wrap: wrap; gap: 20px 32px; align-items: center;">
        <div style="text-align: center;">
          <span style="font-size: 0.72rem; color: rgba(240,237,232,0.5); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; display: block;">FMB</span>
          <span style="font-size: 0.6rem; color: rgba(240,237,232,0.55);">No. 48291</span>
        </div>
        <div style="text-align: center;">
          <span style="font-size: 0.72rem; color: rgba(240,237,232,0.5); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; display: block;">TrustMark</span>
          <span style="font-size: 0.6rem; color: rgba(240,237,232,0.55);">TM39841</span>
        </div>
        <div style="text-align: center;">
          <span style="font-size: 0.72rem; color: rgba(240,237,232,0.5); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; display: block;">Checkatrade</span>
          <span style="font-size: 0.6rem; color: rgba(240,237,232,0.55);">9.8/10</span>
        </div>
        <div style="text-align: center;">
          <span style="font-size: 0.72rem; color: rgba(240,237,232,0.5); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; display: block;">LABC</span>
          <span style="font-size: 0.6rem; color: rgba(240,237,232,0.55);">Partner</span>
        </div>
        <div style="text-align: center;">
          <span style="font-size: 0.72rem; color: rgba(240,237,232,0.5); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; display: block;">NHBC</span>
          <span style="font-size: 0.6rem; color: rgba(240,237,232,0.55);">Registered</span>
        </div>
        <div style="text-align: center;">
          <span style="font-size: 0.72rem; color: rgba(240,237,232,0.5); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; display: block;">Which?</span>
          <span style="font-size: 0.6rem; color: rgba(240,237,232,0.55);">Trusted Trader</span>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div style="border-top: 1px solid rgba(240,237,232,0.06); padding-top: 20px; display: flex; justify-content: center; flex-wrap: wrap; gap: 8px 24px;">
      <span style="font-size: 0.72rem; color: rgba(240,237,232,0.55);">
        &copy; {new Date().getFullYear()} {SITE.legalName}. All rights reserved.
      </span>
      <span style="font-size: 0.72rem; color: rgba(240,237,232,0.5);">
        Company No. {SITE.companyNumber} · VAT {SITE.vatNumber}
      </span>
      <a href="/privacy/" style="font-size: 0.72rem; color: rgba(240,237,232,0.55); transition: color 0.3s ease;" class="hover:text-text-light">Privacy Policy</a>
      <a href="/terms/" style="font-size: 0.72rem; color: rgba(240,237,232,0.55); transition: color 0.3s ease;" class="hover:text-text-light">Terms</a>
    </div>
  </div>
</footer>
