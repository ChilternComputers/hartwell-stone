---
import { projects as allProjects } from '@/data/projects';
import { badgeColors } from '@/lib/constants';

const projects = allProjects.slice(0, 4);
---

<section style="padding: 96px 0; background: var(--color-stone);">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
    <div style="text-align: center; margin-bottom: 56px;" data-reveal="left">
      <span class="eyebrow" style="display: block; margin-bottom: 12px;">Selected Work</span>
      <h2 class="font-heading">Featured Projects</h2>
    </div>

    <!-- Masonry-style layout: alternating tall/standard -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4" style="gap: 20px;" data-stagger-parent>
      {projects.map((project, i) => {
        const tall = i % 2 === 0;
        const imgH = tall ? '340px' : '260px';
        const bg = badgeColors[project.type] || 'rgba(184,134,11,0.9)';
        return (
          <div
            class="project-card geo-cut"
            style={`background: var(--color-charcoal); overflow: hidden; ${tall ? 'margin-top: 0;' : 'margin-top: 32px;'}`}
            data-stagger-child
          >
            <div class="img-zoom" style="position: relative; overflow: hidden;">
              <img
                src={project.image}
                srcset={`${project.image.replace('.webp', '-400w.webp')} 400w, ${project.image.replace('.webp', '-800w.webp')} 800w, ${project.image.replace('.webp', '-1200w.webp')} 1200w`}
                sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 25vw"
                alt={`${project.title} in ${project.location}`}
                width="600"
                height="400"
                loading="lazy"
                style={`width: 100%; height: ${imgH}; object-fit: cover; display: block;`}
              />
              <div class="project-card-overlay">
                <span style={`font-size: 0.65rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #fff; display: inline-block; padding: 4px 10px; background: ${bg}; align-self: flex-start; margin-bottom: 10px;`}>
                  {project.type}
                </span>
                <span class="font-heading" style="font-size: 1.15rem; color: var(--color-text-light); display: block; margin-bottom: 4px;">
                  {project.title}
                </span>
                <span style="font-size: 0.82rem; color: rgba(240,237,232,0.75);">
                  {project.value} · {project.location}
                </span>
              </div>
              <div class="project-card-border"></div>
            </div>
            <div style="padding: 20px;">
              <span style={`font-size: 0.63rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #fff; display: inline-block; margin-bottom: 6px; padding: 3px 8px; background: ${bg};`}>
                {project.type}
              </span>
              <h3 class="font-heading" style="font-size: 1.1rem; color: var(--color-text-light); margin-bottom: 2px;">
                {project.title}
              </h3>
              <span style="font-size: 0.8rem; color: rgba(240,237,232,0.7);">
                {project.value} · {project.location}
              </span>
            </div>
          </div>
        );
      })}
    </div>

    <div style="text-align: center; margin-top: 48px;" data-reveal="fade">
      <a href="/projects/" class="btn-primary btn-outline" style="padding: 14px 32px;">
        View All Projects
      </a>
    </div>
  </div>
</section>
