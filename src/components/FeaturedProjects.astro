---
const projects = [
  {
    title: 'Victorian Rear Extension',
    type: 'Extension',
    location: 'Chelmsford',
    image: '/images/projects/project-1.svg',
  },
  {
    title: 'L-Shaped Loft Conversion',
    type: 'Loft Conversion',
    location: 'Brentwood',
    image: '/images/projects/project-2.svg',
  },
  {
    title: 'Complete Home Renovation',
    type: 'Renovation',
    location: 'Billericay',
    image: '/images/projects/project-3.svg',
  },
];
---

<section style="padding: 96px 0; background: var(--color-stone);">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
    <div style="text-align: center; margin-bottom: 56px;" data-reveal>
      <span class="eyebrow" style="display: block; margin-bottom: 12px;">Our Work</span>
      <h2 class="font-heading">Featured Projects</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3" style="gap: 24px;" data-stagger-parent>
      {projects.map((project) => (
        <div class="img-zoom" style="position: relative; background: var(--color-charcoal); overflow: hidden;" data-stagger-child>
          <img
            src={project.image}
            alt={`${project.title} in ${project.location}`}
            width="600"
            height="400"
            loading="lazy"
            style="width: 100%; height: 300px; object-fit: cover; display: block;"
          />
          <div style="padding: 24px;">
            <span style="font-size: 0.7rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-brass-light); display: block; margin-bottom: 6px;">
              {project.type}
            </span>
            <h3 class="font-heading" style="font-size: 1.2rem; color: var(--color-text-light); margin-bottom: 4px;">
              {project.title}
            </h3>
            <span style="font-size: 0.82rem; color: rgba(240,237,232,0.5);">
              {project.location}
            </span>
          </div>
        </div>
      ))}
    </div>

    <div style="text-align: center; margin-top: 40px;" data-reveal>
      <a href="/projects/" class="btn-primary btn-outline" style="padding: 14px 32px;">
        View All Projects
      </a>
    </div>
  </div>
</section>
