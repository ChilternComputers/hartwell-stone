---
import Layout from '@/layouts/Layout.astro';
import { SITE } from '@/config';
import BookingForm from '@/components/BookingForm.astro';
import PageHeader from '@/components/PageHeader.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Book a Consultation', item: `${SITE.url}/book/` },
  ],
};
---

<Layout
  title={`Book a Consultation | ${SITE.name}`}
  description="Book a free consultation with Hartwell & Stone. Choose a site visit, video call or office meeting — pick your preferred date and time."
  schema={schema}
>
  <PageHeader
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Book a Consultation' }]}
    eyebrow="Schedule"
    title="Book a Consultation"
    description="Choose how you'd like to meet, pick a date and time, and we'll confirm within the hour. All consultations are complimentary and obligation-free."
  />

  <!-- Booking Form -->
  <section style="padding: 80px 0; background: var(--color-warm-white);">
    <div style="max-width: 800px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
      <div style="background: var(--color-stone); padding: 48px clamp(24px, 4vw, 40px);" data-reveal>
        <BookingForm />
      </div>
    </div>
  </section>

  <!-- Prefer to call -->
  <section style="padding: 48px 0; background: var(--color-stone);">
    <div style="max-width: 600px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px); text-align: center;">
      <p style="font-size: 1rem; color: var(--color-text-secondary); margin-bottom: 16px;">
        Prefer to speak with us directly?
      </p>
      <a
        href={`tel:${SITE.phone.replace(/\s/g, '')}`}
        class="btn-primary btn-fill"
        style="padding: 14px 32px; display: inline-block;"
      >
        Call {SITE.phone}
      </a>
      <p style="font-size: 0.82rem; color: var(--color-text-muted); margin-top: 12px;">
        {SITE.hours.weekday} · {SITE.hours.saturday}
      </p>
    </div>
  </section>
</Layout>
