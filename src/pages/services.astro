---
import Layout from '@/layouts/Layout.astro';
import { SITE } from '@/config';
import { services, faqs } from '@/data/services';
import CTABanner from '@/components/CTABanner.astro';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE.url}/services/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];
---

<Layout
  title={`Our Services | ${SITE.name}`}
  description="Extensions, loft conversions, renovations, new builds, kitchens and bathrooms. Premium residential construction services across Essex."
  schema={schema}
>
  <!-- Page Header -->
  <section style="padding: 140px 0 64px; background: var(--color-charcoal);">
    <div style="max-width: 900px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px); text-align: center;">
      <span class="eyebrow eyebrow-light" style="display: block; margin-bottom: 12px;">What We Do</span>
      <h1 class="font-heading" style="color: var(--color-text-light);">Our Services</h1>
      <p style="font-size: 1rem; color: rgba(240,237,232,0.7); line-height: 1.8; margin-top: 16px; max-width: 600px; margin-left: auto; margin-right: auto;">
        From single-storey extensions to complete new builds, we deliver premium residential construction across Essex.
      </p>
    </div>
  </section>

  <!-- Services -->
  {services.map((service, i) => (
    <section
      id={service.id}
      style={`padding: 80px 0; background: ${i % 2 === 0 ? 'var(--color-warm-white)' : 'var(--color-stone)'};`}
    >
      <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
        <div class={`grid grid-cols-1 lg:grid-cols-2`} style="gap: 48px; align-items: center;">
          <div style={i % 2 === 1 ? 'order: 2;' : ''} data-reveal>
            <span class="eyebrow" style="display: block; margin-bottom: 12px;">{service.priceRange}</span>
            <h2 class="font-heading" style="margin-bottom: 16px;">{service.title}</h2>
            <p style="font-size: 0.95rem; color: rgba(44,44,46,0.7); line-height: 1.8; margin-bottom: 24px;">
              {service.description}
            </p>
            <ul style="list-style: none; padding: 0; margin: 0 0 24px 0; display: flex; flex-direction: column; gap: 8px;">
              {service.features.map((feature) => (
                <li style="font-size: 0.88rem; color: var(--color-text-dark); display: flex; align-items: flex-start; gap: 10px;">
                  <span style="color: var(--color-brass); font-weight: 700; flex-shrink: 0; margin-top: 2px;">✓</span>
                  {feature}
                </li>
              ))}
            </ul>
            <a href="/contact/" class="btn-primary btn-fill" style="padding: 14px 28px;">
              Get a Quote
            </a>
          </div>
          <div style={i % 2 === 1 ? 'order: 1;' : ''} data-reveal>
            <img
              src={service.image}
              alt={service.title}
              width="600"
              height="400"
              loading="lazy"
              style="width: 100%; height: auto; object-fit: cover;"
            />
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- FAQ -->
  <section style="padding: 96px 0; background: var(--color-warm-white);">
    <div style="max-width: 800px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
      <div style="text-align: center; margin-bottom: 48px;" data-reveal>
        <span class="eyebrow" style="display: block; margin-bottom: 12px;">FAQ</span>
        <h2 class="font-heading">Common Questions</h2>
      </div>

      <div style="display: flex; flex-direction: column; gap: 16px;" data-stagger-parent>
        {faqs.map((faq) => (
          <details style="border: 1px solid var(--color-border); background: var(--color-stone);" data-stagger-child>
            <summary style="padding: 20px 24px; cursor: pointer; font-weight: 500; font-size: 0.95rem; color: var(--color-charcoal); list-style: none; display: flex; justify-content: space-between; align-items: center;">
              {faq.question}
              <span style="color: var(--color-brass); font-size: 1.2rem; flex-shrink: 0; margin-left: 16px;" aria-hidden="true">+</span>
            </summary>
            <div style="padding: 0 24px 20px;">
              <p style="font-size: 0.9rem; color: rgba(44,44,46,0.7); line-height: 1.8;">
                {faq.answer}
              </p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTABanner />
</Layout>
