---
import Layout from '@/layouts/Layout.astro';
import { SITE } from '@/config';
import { services } from '@/data/services';
import { faqs } from '@/data/faqs';
import PageHeader from '@/components/PageHeader.astro';
import CTABanner from '@/components/CTABanner.astro';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE.url}/services/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.slice(0, 3).map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];
---

<Layout
  title={`Services | ${SITE.name} — Builds, Heritage & More`}
  description="Bespoke new builds, heritage restorations, extensions and barn conversions. Award-winning residential construction across the South East."
  schema={schema}
>
  <PageHeader
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Services' }]}
    eyebrow="Our Expertise"
    title="What We Do"
    description="From bespoke new builds to sensitive heritage restorations, we deliver construction of uncompromising quality — managed from first consultation to final handover."
  />

  <!-- Services -->
  {services.map((service, i) => (
    <section
      id={service.id}
      style={`padding: 80px 0; background: ${i % 2 === 0 ? 'var(--color-warm-white)' : 'var(--color-stone)'};`}
    >
      <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
        <div class={`grid grid-cols-1 lg:grid-cols-2`} style="gap: 48px; align-items: center;">
          <div style={i % 2 === 1 ? 'order: 2;' : ''} data-reveal>
            <span class="eyebrow" style="display: block; margin-bottom: 12px;">{service.startingFrom}</span>
            <h2 class="font-heading" style="margin-bottom: 16px;">{service.title}</h2>
            <p style="font-size: 0.95rem; color: var(--color-text-secondary); line-height: 1.8; margin-bottom: 24px;">
              {service.description}
            </p>

            <!-- Key features tags -->
            <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px;">
              {service.keyFeatures.map((kf) => (
                <span style="font-size: 0.72rem; padding: 4px 12px; background: rgba(184,134,11,0.1); color: var(--color-brass-dark); font-weight: 600; letter-spacing: 0.04em;">{kf}</span>
              ))}
            </div>

            <ul style="list-style: none; padding: 0; margin: 0 0 24px 0; display: flex; flex-direction: column; gap: 8px;">
              {service.features.map((feature) => (
                <li style="font-size: 0.88rem; color: var(--color-text-dark); display: flex; align-items: flex-start; gap: 10px;">
                  <span style="color: var(--color-brass-dark); font-weight: 700; flex-shrink: 0; margin-top: 2px;">&#10003;</span>
                  {feature}
                </li>
              ))}
            </ul>

            <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
              <a href="/contact/" class="btn-primary btn-fill" style="padding: 14px 28px;">
                Discuss This Service
              </a>
              <a href="/projects/" class="btn-primary btn-outline" style="padding: 14px 28px;">
                View {service.title} Projects &rarr;
              </a>
              <span style="font-size: 0.82rem; color: var(--color-text-muted);">
                {service.priceRange}
              </span>
            </div>
          </div>
          <div style={i % 2 === 1 ? 'order: 1;' : ''} data-reveal>
            <img
              src={service.image}
              srcset={`${service.image.replace('.webp', '-400w.webp')} 400w, ${service.image.replace('.webp', '-800w.webp')} 800w, ${service.image.replace('.webp', '-1200w.webp')} 1200w`}
              sizes="(max-width: 768px) 100vw, 50vw"
              alt={`Example of ${service.title.toLowerCase()} by Hartwell & Stone`}
              width="600"
              height="400"
              loading="lazy"
              style="width: 100%; height: auto; object-fit: cover;"
            />
          </div>
        </div>

        <!-- Process steps -->
        <div style="margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--color-border);" data-reveal>
          <h3 style="font-family: var(--font-body); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-brass-dark); margin-bottom: 16px;">Typical Process</h3>
          <div style="display: flex; flex-wrap: wrap; gap: 8px;">
            {service.process.map((step, si) => (
              <span style="font-size: 0.78rem; color: var(--color-text-muted); display: flex; align-items: center; gap: 6px;">
                <span style="font-weight: 700; color: var(--color-brass-dark); font-size: 0.7rem;">{String(si + 1).padStart(2, '0')}</span>
                {step}
                {si < service.process.length - 1 && <span style="color: rgba(44,44,46,0.2); margin-left: 8px;" aria-hidden="true">&#8594;</span>}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- FAQ Preview -->
  <section style="padding: 96px 0; background: var(--color-warm-white);">
    <div style="max-width: 800px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
      <div style="text-align: center; margin-bottom: 48px;" data-reveal>
        <span class="eyebrow" style="display: block; margin-bottom: 12px;">FAQ</span>
        <h2 class="font-heading">Common Questions</h2>
      </div>

      <div style="display: flex; flex-direction: column; gap: 16px;" data-stagger-parent>
        {faqs.slice(0, 3).map((faq) => (
          <details style="border: 1px solid var(--color-border); background: var(--color-stone);" data-stagger-child>
            <summary style="padding: 20px 24px; cursor: pointer; font-weight: 500; font-size: 0.95rem; color: var(--color-charcoal); list-style: none; display: flex; justify-content: space-between; align-items: center;">
              {faq.question}
              <span style="color: var(--color-brass-dark); font-size: 1.2rem; flex-shrink: 0; margin-left: 16px;" aria-hidden="true">+</span>
            </summary>
            <div style="padding: 0 24px 20px;">
              <p style="font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.8;">
                {faq.answer}
              </p>
            </div>
          </details>
        ))}
      </div>

      <div style="text-align: center; margin-top: 32px;" data-reveal>
        <a href="/faq/" class="btn-primary btn-outline" style="padding: 14px 32px;">View All FAQs &rarr;</a>
      </div>
    </div>
  </section>

  <CTABanner />
</Layout>
