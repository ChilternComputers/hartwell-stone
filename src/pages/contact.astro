---
import Layout from '@/layouts/Layout.astro';
import { SITE } from '@/config';
import QuoteForm from '@/components/QuoteForm.astro';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: `${SITE.url}/contact/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: SITE.name,
    telephone: SITE.phone,
    email: SITE.email,
    url: SITE.url,
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.address.street,
      addressLocality: SITE.address.area,
      addressRegion: SITE.address.city,
      postalCode: SITE.address.postcode,
      addressCountry: SITE.address.country,
    },
    openingHoursSpecification: [
      { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '07:30', closes: '17:30' },
      { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '13:00' },
    ],
  },
];
---

<Layout
  title={`Contact Us | ${SITE.name} — Arrange a Complimentary Consultation`}
  description="Arrange a complimentary site consultation. Call, email or submit a project enquiry. We'll visit your property, listen to your aspirations and provide honest guidance — no obligation."
  schema={schema}
>
  <!-- Page Header -->
  <section style="padding: 140px 0 64px; background: var(--color-charcoal);">
    <div style="max-width: 900px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px); text-align: center;">
      <span class="eyebrow eyebrow-light" style="display: block; margin-bottom: 12px;">Get In Touch</span>
      <h1 class="font-heading" style="color: var(--color-text-light);">Start a Conversation</h1>
      <p style="font-size: 1rem; color: rgba(240,237,232,0.85); line-height: 1.8; margin-top: 16px;">
        Every exceptional home begins with a conversation. Arrange a complimentary site consultation — we'll listen to your aspirations and provide honest, expert guidance.
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section style="padding: 80px 0; background: var(--color-warm-white);">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
      <div class="grid grid-cols-1 lg:grid-cols-5" style="gap: 48px;">

        <!-- Contact Info (2 cols) -->
        <div class="lg:col-span-2" data-reveal>
          <h2 class="font-heading" style="font-size: 1.8rem; margin-bottom: 24px;">Get in Touch</h2>

          <div style="display: flex; flex-direction: column; gap: 24px; margin-bottom: 32px;">
            <div>
              <span style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-brass-dark); display: block; margin-bottom: 6px;">Phone</span>
              <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} style="font-size: 1.1rem; font-weight: 500; color: var(--color-charcoal); transition: color 0.3s ease;">
                {SITE.phone}
              </a>
            </div>

            <div>
              <span style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-brass-dark); display: block; margin-bottom: 6px;">Email</span>
              <a href={`mailto:${SITE.email}`} style="font-size: 1rem; color: var(--color-charcoal); transition: color 0.3s ease;">
                {SITE.email}
              </a>
            </div>

            <div>
              <span style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-brass-dark); display: block; margin-bottom: 6px;">WhatsApp</span>
              <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener noreferrer" style="font-size: 1rem; color: var(--color-charcoal); transition: color 0.3s ease;">
                Message us on WhatsApp
              </a>
            </div>

            <div>
              <span style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-brass-dark); display: block; margin-bottom: 6px;">Office</span>
              <p style="font-size: 0.95rem; color: var(--color-text-dark); line-height: 1.7;">
                {SITE.address.street}<br />
                {SITE.address.area}, {SITE.address.city}<br />
                {SITE.address.postcode}
              </p>
            </div>

            <div>
              <span style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-brass-dark); display: block; margin-bottom: 6px;">Opening Hours</span>
              <p style="font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.8;">
                {SITE.hours.weekday}<br />
                {SITE.hours.saturday}<br />
                {SITE.hours.sunday}
              </p>
            </div>
          </div>

          <div style="padding: 24px; background: var(--color-stone); border-left: 3px solid var(--color-brass);">
            <p style="font-size: 0.88rem; color: var(--color-text-dark); line-height: 1.7;">
              <strong>Complimentary consultations</strong> — We offer free site visits across Essex and the South East. No hard sell — just honest, expert advice about your project's potential.
            </p>
          </div>
        </div>

        <!-- Project Enquiry Form (3 cols) -->
        <div class="lg:col-span-3" style="background: var(--color-stone); padding: 40px;" data-reveal>
          <h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 8px; text-align: center;">Project Enquiry</h2>
          <p style="font-size: 0.88rem; color: var(--color-text-muted); text-align: center; margin-bottom: 32px;">
            Tell us about your project and a member of our team will be in touch within 24 hours.
          </p>
          <QuoteForm />
        </div>

      </div>
    </div>
  </section>
</Layout>
