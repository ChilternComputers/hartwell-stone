---
import Layout from '@/layouts/Layout.astro';
import { SITE } from '@/config';
import QuoteForm from '@/components/QuoteForm.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: `${SITE.url}/contact/` },
  ],
};
---

<Layout
  title={`Contact Us | ${SITE.name}`}
  description="Get a free, no-obligation quote for your construction project. Call us, email, or fill in our online form. Serving Essex and beyond."
  schema={schema}
>
  <!-- Page Header -->
  <section style="padding: 140px 0 64px; background: var(--color-charcoal);">
    <div style="max-width: 900px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px); text-align: center;">
      <span class="eyebrow eyebrow-light" style="display: block; margin-bottom: 12px;">Get In Touch</span>
      <h1 class="font-heading" style="color: var(--color-text-light);">Contact Us</h1>
      <p style="font-size: 1rem; color: rgba(240,237,232,0.7); line-height: 1.8; margin-top: 16px;">
        Ready to discuss your project? Get in touch for a free, no-obligation consultation.
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section style="padding: 80px 0; background: var(--color-warm-white);">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
      <div class="grid grid-cols-1 lg:grid-cols-5" style="gap: 48px;">

        <!-- Contact Info (2 cols) -->
        <div class="lg:col-span-2" data-reveal>
          <h2 class="font-heading" style="font-size: 1.8rem; margin-bottom: 24px;">Get in Touch</h2>

          <div style="display: flex; flex-direction: column; gap: 24px; margin-bottom: 32px;">
            <div>
              <span style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-brass); display: block; margin-bottom: 6px;">Phone</span>
              <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} style="font-size: 1.1rem; font-weight: 500; color: var(--color-charcoal); transition: color 0.3s ease;">
                {SITE.phone}
              </a>
            </div>

            <div>
              <span style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-brass); display: block; margin-bottom: 6px;">Email</span>
              <a href={`mailto:${SITE.email}`} style="font-size: 1rem; color: var(--color-charcoal); transition: color 0.3s ease;">
                {SITE.email}
              </a>
            </div>

            <div>
              <span style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-brass); display: block; margin-bottom: 6px;">WhatsApp</span>
              <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener noreferrer" style="font-size: 1rem; color: var(--color-charcoal); transition: color 0.3s ease;">
                Message us on WhatsApp
              </a>
            </div>

            <div>
              <span style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-brass); display: block; margin-bottom: 6px;">Address</span>
              <p style="font-size: 0.95rem; color: var(--color-text-dark); line-height: 1.7;">
                {SITE.address.street}<br />
                {SITE.address.area}, {SITE.address.city}<br />
                {SITE.address.postcode}
              </p>
            </div>

            <div>
              <span style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-brass); display: block; margin-bottom: 6px;">Opening Hours</span>
              <p style="font-size: 0.9rem; color: rgba(44,44,46,0.7); line-height: 1.8;">
                {SITE.hours.weekday}<br />
                {SITE.hours.saturday}<br />
                {SITE.hours.sunday}
              </p>
            </div>
          </div>

          <div style="padding: 24px; background: var(--color-stone); border-left: 3px solid var(--color-brass);">
            <p style="font-size: 0.88rem; color: var(--color-text-dark); line-height: 1.7;">
              <strong>Free consultations</strong> — We offer free site visits across Essex. No hard sell, just honest advice about your project.
            </p>
          </div>
        </div>

        <!-- Quote Form (3 cols) -->
        <div class="lg:col-span-3" style="background: var(--color-stone); padding: 40px;" data-reveal>
          <h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 8px; text-align: center;">Request a Free Quote</h2>
          <p style="font-size: 0.88rem; color: rgba(44,44,46,0.6); text-align: center; margin-bottom: 32px;">
            Tell us about your project and we'll get back to you within 24 hours.
          </p>
          <QuoteForm />
        </div>

      </div>
    </div>
  </section>

  <!-- Sticky mobile CTA -->
  <div
    class="lg:hidden"
    style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 40; background: var(--color-charcoal); padding: 12px 16px; display: flex; gap: 12px; border-top: 1px solid rgba(184,134,11,0.3);"
  >
    <a
      href={`tel:${SITE.phone.replace(/\s/g, '')}`}
      class="btn-primary btn-fill"
      style="flex: 1; padding: 14px; text-align: center;"
    >
      Call Now
    </a>
    <a
      href={`https://wa.me/${SITE.whatsapp}`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-primary btn-outline-light"
      style="flex: 1; padding: 14px; text-align: center;"
    >
      WhatsApp
    </a>
  </div>
</Layout>
