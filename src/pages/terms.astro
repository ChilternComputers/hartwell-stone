---
import Layout from '@/layouts/Layout.astro';
import { SITE } from '@/config';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Terms', item: `${SITE.url}/terms/` },
  ],
};
---

<Layout
  title={`Terms of Service | ${SITE.name}`}
  description="Terms and conditions for using the Hartwell & Stone Construction website."
  schema={schema}
  noindex={true}
>
  <section style="padding: 140px 0 64px; background: var(--color-charcoal);">
    <div style="max-width: 900px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px); text-align: center;">
      <h1 class="font-heading" style="color: var(--color-text-light);">Terms of Service</h1>
    </div>
  </section>

  <section style="padding: 64px 0; background: var(--color-warm-white);">
    <div style="max-width: 720px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
      <p style="font-size: 0.88rem; color: rgba(44,44,46,0.6); margin-bottom: 32px;">Last updated: March 2026</p>

      <div style="display: flex; flex-direction: column; gap: 32px;">
        <div>
          <h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 12px;">1. About This Website</h2>
          <p style="font-size: 0.92rem; color: rgba(44,44,46,0.75); line-height: 1.8;">
            This website is operated by {SITE.legalName}. By accessing and using this website, you accept these terms in full. If you disagree with any part, please do not use this website.
          </p>
        </div>

        <div>
          <h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 12px;">2. Intellectual Property</h2>
          <p style="font-size: 0.92rem; color: rgba(44,44,46,0.75); line-height: 1.8;">
            All content on this website — including text, images, design and code — is the property of {SITE.legalName} and is protected by copyright law. You may not reproduce, distribute, or modify any content without prior written permission.
          </p>
        </div>

        <div>
          <h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 12px;">3. Quotations & Pricing</h2>
          <p style="font-size: 0.92rem; color: rgba(44,44,46,0.75); line-height: 1.8;">
            Price ranges and cost guides shown on this website are indicative only and do not constitute a formal quotation. All project pricing is provided following a site visit and detailed assessment. Formal quotations are valid for 30 days unless otherwise stated.
          </p>
        </div>

        <div>
          <h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 12px;">4. Limitation of Liability</h2>
          <p style="font-size: 0.92rem; color: rgba(44,44,46,0.75); line-height: 1.8;">
            While we make every effort to ensure the accuracy of information on this website, we do not guarantee that the content is error-free. {SITE.legalName} shall not be liable for any losses arising from reliance on information provided on this website.
          </p>
        </div>

        <div>
          <h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 12px;">5. External Links</h2>
          <p style="font-size: 0.92rem; color: rgba(44,44,46,0.75); line-height: 1.8;">
            This website may contain links to external websites. We are not responsible for the content or privacy practices of those sites.
          </p>
        </div>

        <div>
          <h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 12px;">6. Governing Law</h2>
          <p style="font-size: 0.92rem; color: rgba(44,44,46,0.75); line-height: 1.8;">
            These terms are governed by the laws of England and Wales. Any disputes shall be subject to the exclusive jurisdiction of the English courts.
          </p>
        </div>

        <div>
          <h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 12px;">7. Contact</h2>
          <p style="font-size: 0.92rem; color: rgba(44,44,46,0.75); line-height: 1.8;">
            For questions about these terms, contact us at <a href={`mailto:${SITE.email}`} style="color: var(--color-brass);">{SITE.email}</a> or call <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} style="color: var(--color-brass);">{SITE.phone}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
