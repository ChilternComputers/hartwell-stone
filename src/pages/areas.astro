---
import Layout from '@/layouts/Layout.astro';
import { SITE } from '@/config';
import CTABanner from '@/components/CTABanner.astro';

const regions = [
  {
    name: 'Central Essex',
    areas: [
      { name: 'Chelmsford', desc: 'Our home base. Full range of construction services in the county town.' },
      { name: 'Broomfield', desc: 'Extensions, loft conversions and renovations for this popular residential area.' },
      { name: 'Writtle', desc: 'Serving the village and surrounding rural properties with bespoke builds.' },
      { name: 'Springfield', desc: 'Close to our offices — quick response times for consultations and builds.' },
    ],
  },
  {
    name: 'West Essex',
    areas: [
      { name: 'Brentwood', desc: 'Premium residential construction in one of Essex\'s most desirable areas.' },
      { name: 'Billericay', desc: 'Extensions, renovations and new builds for this thriving market town.' },
      { name: 'Ingatestone', desc: 'Bespoke construction services for village and rural properties.' },
      { name: 'Shenfield', desc: 'High-quality residential builds in this commuter-friendly location.' },
    ],
  },
  {
    name: 'South Essex',
    areas: [
      { name: 'Basildon', desc: 'Full construction services across Basildon and surrounding areas.' },
      { name: 'Southend-on-Sea', desc: 'Extensions and renovations along the Essex coast.' },
      { name: 'Rayleigh', desc: 'Loft conversions, extensions and bathroom installations.' },
      { name: 'Wickford', desc: 'Residential construction and home improvement projects.' },
    ],
  },
  {
    name: 'East London & Beyond',
    areas: [
      { name: 'Romford', desc: 'Extensions, loft conversions and full renovations across Romford.' },
      { name: 'Hornchurch', desc: 'Premium construction services for this popular residential borough.' },
      { name: 'Colchester', desc: 'Serving north Essex with the same high standards and personal service.' },
      { name: 'Maldon', desc: 'Construction projects in the Blackwater estuary area and surrounds.' },
    ],
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Service Areas', item: `${SITE.url}/areas/` },
  ],
};
---

<Layout
  title={`Service Areas | ${SITE.name}`}
  description="Hartwell & Stone serves Chelmsford, Brentwood, Billericay, Romford, Basildon, Southend and all of Essex. Find your local builder."
  schema={schema}
>
  <!-- Page Header -->
  <section style="padding: 140px 0 64px; background: var(--color-charcoal);">
    <div style="max-width: 900px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px); text-align: center;">
      <span class="eyebrow eyebrow-light" style="display: block; margin-bottom: 12px;">Coverage</span>
      <h1 class="font-heading" style="color: var(--color-text-light);">Our Service Areas</h1>
      <p style="font-size: 1rem; color: rgba(240,237,232,0.7); line-height: 1.8; margin-top: 16px; max-width: 600px; margin-left: auto; margin-right: auto;">
        Based in Chelmsford, we provide premium residential construction across Essex and into East London.
      </p>
    </div>
  </section>

  <!-- Areas -->
  {regions.map((region, i) => (
    <section style={`padding: 64px 0; background: ${i % 2 === 0 ? 'var(--color-warm-white)' : 'var(--color-stone)'};`}>
      <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
        <h2 class="font-heading" style="font-size: 1.8rem; margin-bottom: 32px; text-align: center;" data-reveal>{region.name}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4" style="gap: 20px;" data-stagger-parent>
          {region.areas.map((area) => (
            <div style="padding: 24px; background: var(--color-warm-white); border: 1px solid var(--color-border);" data-stagger-child>
              <h3 style="font-family: var(--font-body); font-size: 1rem; font-weight: 600; color: var(--color-charcoal); margin-bottom: 8px;">{area.name}</h3>
              <p style="font-size: 0.85rem; color: rgba(44,44,46,0.65); line-height: 1.7;">{area.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <CTABanner />
</Layout>
