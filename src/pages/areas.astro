---
import Layout from '@/layouts/Layout.astro';
import { SITE } from '@/config';
import { areas as areaData } from '@/data/areas';
import CTABanner from '@/components/CTABanner.astro';
import PageHeader from '@/components/PageHeader.astro';

// Build a set of slugs that have dedicated pages
const areaSlugs = new Map(areaData.map((a) => [a.name.toLowerCase(), a.slug]));

// Helper to get slug for an area name if it has a dedicated page
function getAreaSlug(name: string): string | undefined {
  // Direct match
  const direct = areaSlugs.get(name.toLowerCase());
  if (direct) return direct;
  // Try matching with common variations
  const normalised = name.toLowerCase().replace(/[^a-z ]/g, '').trim();
  for (const [key, slug] of areaSlugs) {
    if (key.includes(normalised) || normalised.includes(key)) return slug;
  }
  return undefined;
}

const regions = [
  {
    name: 'Essex & East Anglia',
    desc: `Our heartland — where we've been building for ${SITE.yearsExperience} years.`,
    areas: [
      { name: 'Chelmsford', desc: 'Our home base and headquarters. Full range of services with the shortest lead times.' },
      { name: 'Brentwood', desc: 'One of our most active areas — premium residential construction in one of Essex\'s most desirable addresses.' },
      { name: 'Billericay', desc: 'Extensions, renovations and new builds for this thriving market town and surrounding villages.' },
      { name: 'Ingatestone', desc: 'Bespoke construction services for village properties and rural estates.' },
      { name: 'Maldon', desc: 'Heritage conversions and residential projects in the Blackwater estuary area.' },
      { name: 'Colchester', desc: 'Serving north Essex with the same exacting standards and personal service.' },
      { name: 'Shenfield', desc: 'Premium extensions and renovations in this sought-after Elizabeth line commuter town.' },
      { name: 'Writtle', desc: 'Heritage restorations and barn conversions in one of Essex\'s most picturesque villages.' },
      { name: 'Harlow', desc: 'Modern renovations, extensions and new builds across the town and surrounding villages.' },
      { name: 'Epping', desc: 'Sensitive extensions and renovations navigating Green Belt planning constraints.' },
      { name: 'Leigh-on-Sea', desc: 'Characterful renovations and coastal extensions in south Essex\'s creative heart.' },
      { name: 'Wickford', desc: 'Quality extensions and renovations transforming family homes across south Essex.' },
      { name: 'South Woodham Ferrers', desc: 'Contemporary extensions and modernisations in this riverside planned town.' },
      { name: 'Danbury', desc: 'Conservation-sensitive construction in this desirable hilltop village near Chelmsford.' },
    ],
  },
  {
    name: 'London & Home Counties',
    desc: 'Easy access from our Chelmsford base for projects across the capital and surrounding counties.',
    areas: [
      { name: 'East London', desc: 'Extensions, renovations and conversions across Ilford, Stratford and surrounding boroughs.' },
      { name: 'Romford', desc: 'Extensions and heritage restorations across Havering, from Gidea Park to Emerson Park.' },
      { name: 'Hornchurch', desc: 'Family home extensions, loft conversions and renovations in this popular outer London area.' },
      { name: 'Upminster', desc: 'Substantial extensions and new builds on generous plots in this village-like London borough.' },
      { name: 'North London', desc: 'Heritage restoration and new build projects in Enfield, Barnet and the northern boroughs.' },
      { name: 'Hertfordshire', desc: 'Bespoke residential construction in Bishop\'s Stortford, Ware, Hertford and surrounding areas.' },
      { name: 'Kent', desc: 'Selected projects in north Kent, including Sevenoaks, Tonbridge and the Weald.' },
    ],
  },
  {
    name: 'South East & East Anglia',
    desc: 'Extended coverage for larger commissions.',
    areas: [
      { name: 'Suffolk', desc: 'Barn conversions and heritage projects in Lavenham, Long Melford, Bury St Edmunds and surrounds.' },
      { name: 'Cambridge', desc: 'New builds and renovation projects in the city and surrounding villages.' },
      { name: 'Surrey', desc: 'Selected projects in Guildford, Farnham, Esher and the Surrey Hills.' },
      { name: 'Sussex', desc: 'Heritage and new build projects in Chichester, Lewes, Brighton and the South Downs.' },
    ],
  },
  {
    name: 'Nationwide by Arrangement',
    desc: 'For projects typically exceeding £500,000, we work nationwide.',
    areas: [
      { name: 'The Cotswolds', desc: 'Stone barn conversions and period property renovations. Current furthest active project.' },
      { name: 'The Midlands', desc: 'New builds and large-scale residential projects across the region.' },
      { name: 'The South West', desc: 'Heritage projects in Bath, Bristol, Dorset and Devon by arrangement.' },
      { name: 'Nationwide', desc: 'Contact us for any project above £500,000 — we\'ll assess feasibility and logistics.' },
    ],
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Service Areas', item: `${SITE.url}/areas/` },
  ],
};
---

<Layout
  title={`Service Areas | ${SITE.name} — Nationwide Coverage`}
  description="Based in Chelmsford, Hartwell & Stone serves Essex, London, the Home Counties and East Anglia. Nationwide coverage for larger projects by arrangement."
  schema={schema}
>
  <PageHeader
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Service Areas' }]}
    eyebrow="Coverage"
    title="Where We Work"
    description="Based in Chelmsford, we work across Essex, London and the South East as standard. For larger commissions, we operate nationwide by arrangement."
  />

  <!-- Areas -->
  {regions.map((region, i) => (
    <section style={`padding: 64px 0; background: ${i % 2 === 0 ? 'var(--color-warm-white)' : 'var(--color-stone)'};`}>
      <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
        <div style="text-align: center; margin-bottom: 32px;" data-reveal>
          <h2 class="font-heading" style="font-size: 1.8rem; margin-bottom: 8px;">{region.name}</h2>
          <p style="font-size: 0.9rem; color: var(--color-text-muted); font-style: italic;">{region.desc}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4" style="gap: 20px;" data-stagger-parent>
          {region.areas.map((area) => {
            const slug = getAreaSlug(area.name);
            const Tag = slug ? 'a' : 'div';
            return (
              <Tag
                {...(slug ? { href: `/areas/${slug}/` } : {})}
                style={`padding: 24px; background: var(--color-warm-white); border: 1px solid var(--color-border); display: block; text-decoration: none; color: inherit; transition: border-color 0.3s ease, box-shadow 0.3s ease;`}
                data-stagger-child
              >
                <h3 style="font-family: var(--font-body); font-size: 1rem; font-weight: 600; color: var(--color-charcoal); margin-bottom: 8px;">{area.name}</h3>
                <p style="font-size: 0.85rem; color: var(--color-text-secondary); line-height: 1.7;">{area.desc}</p>
                {slug && (
                  <span style="display: inline-block; margin-top: 12px; font-size: 0.78rem; font-weight: 600; color: var(--color-brass-dark);">Learn more &rarr;</span>
                )}
              </Tag>
            );
          })}
        </div>
      </div>
    </section>
  ))}

  <!-- Cross-links -->
  <section style="padding: 64px 0; background: var(--color-warm-white);">
    <div style="max-width: 900px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px); text-align: center;" data-reveal>
      <h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 12px;">What We Offer Across Every Area</h2>
      <p style="font-size: 0.95rem; color: var(--color-text-muted); line-height: 1.8; margin-bottom: 32px;">
        Wherever we work, our clients receive the same award-winning craftsmanship and personal service.
      </p>
      <div style="display: flex; justify-content: center; gap: 24px; flex-wrap: wrap;">
        <a href="/services/" class="btn-primary btn-fill" style="display: inline-block; padding: 14px 32px; font-size: 0.88rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; text-decoration: none;">View Our Services</a>
        <a href="/projects/" class="btn-primary btn-outline" style="display: inline-block; padding: 14px 32px; font-size: 0.88rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; text-decoration: none;">See Our Projects</a>
      </div>
    </div>
  </section>

  <CTABanner />
</Layout>

<style>
  a[data-stagger-child]:hover {
    border-color: var(--color-brass) !important;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
  }
</style>
