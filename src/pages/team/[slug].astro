---
import Layout from '@/layouts/Layout.astro';
import { SITE } from '@/config';
import { team } from '@/data/team';
import { projects } from '@/data/projects';
import CTABanner from '@/components/CTABanner.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';

export function getStaticPaths() {
  return team.map((member) => ({
    params: { slug: member.slug },
    props: { member },
  }));
}

const { member } = Astro.props;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'About', item: `${SITE.url}/about/` },
      { '@type': 'ListItem', position: 3, name: member.name, item: `${SITE.url}/team/${member.slug}/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: member.name,
    jobTitle: member.role,
    worksFor: { '@type': 'Organization', name: SITE.name },
    description: member.bio,
    image: `${SITE.url}${member.image}`,
    url: `${SITE.url}/team/${member.slug}/`,
  },
];
---

<Layout
  title={`${member.name} | ${SITE.name}`}
  description={member.metaDescription}
  schema={schema}
>
  <!-- Header -->
  <section style="padding: 140px 0 64px; background: var(--color-charcoal);">
    <div style="max-width: 900px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px); text-align: center;">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'About', href: '/about/' }, { label: member.name }]} />
      <span class="eyebrow eyebrow-light" style="display: block; margin-bottom: 12px;">{member.role}</span>
      <h1 class="font-heading" style="color: var(--color-text-light);">{member.name}</h1>
    </div>
  </section>

  <!-- Profile -->
  <section style="padding: 80px 0; background: var(--color-warm-white);">
    <div style="max-width: 1000px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
      <div class="grid grid-cols-1 lg:grid-cols-3" style="gap: 48px; align-items: start;">
        <!-- Photo + Quick Facts -->
        <div data-reveal>
          <div style="aspect-ratio: 3/4; overflow: hidden; margin-bottom: 24px;">
            <img
              src={member.image}
              alt={`Portrait of ${member.name}, ${member.role} at Hartwell & Stone`}
              width="400"
              height="533"
              loading="eager"
              style="width: 100%; height: 100%; object-fit: cover;"
            />
          </div>

          <!-- Quick facts -->
          <div style="background: var(--color-stone); padding: 24px; border-left: 3px solid var(--color-brass);">
            <h3 style="font-family: var(--font-body); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: 16px;">At a Glance</h3>
            <dl style="margin: 0; display: flex; flex-direction: column; gap: 12px;">
              <div>
                <dt style="font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-muted);">Experience</dt>
                <dd style="font-size: 0.9rem; color: var(--color-charcoal); font-weight: 500; margin: 2px 0 0;">{member.yearsExperience} years</dd>
              </div>
              <div>
                <dt style="font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-muted);">Qualifications</dt>
                <dd style="margin: 2px 0 0;">
                  <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                    {member.qualifications.map((q) => (
                      <span style="font-size: 0.72rem; padding: 3px 8px; background: var(--color-warm-white); color: var(--color-text-secondary); font-weight: 500;">{q}</span>
                    ))}
                  </div>
                </dd>
              </div>
              <div>
                <dt style="font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-muted);">Specialisms</dt>
                <dd style="font-size: 0.85rem; color: var(--color-text-secondary); margin: 2px 0 0; line-height: 1.6;">
                  {member.specialisms.join(' · ')}
                </dd>
              </div>
            </dl>
          </div>
        </div>

        <!-- Extended bio -->
        <div style="grid-column: span 2;" data-reveal>
          <h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 24px;">About {member.name.split(' ')[0]}</h2>
          {member.extendedBio.split('\n\n').map((para) => (
            <p style="font-size: 0.95rem; color: var(--color-text-secondary); line-height: 1.9; margin-bottom: 16px;">
              {para}
            </p>
          ))}

          {member.notable && member.notable.length > 0 && (
            <div style="margin-top: 32px; padding: 24px; background: var(--color-stone); border-left: 3px solid var(--color-brass);">
              <h3 style="font-family: var(--font-body); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: 16px;">Notable Achievements</h3>
              <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;">
                {member.notable.map((item) => (
                  <li style="font-size: 0.9rem; color: var(--color-charcoal); padding-left: 16px; position: relative;">
                    <span style="position: absolute; left: 0; color: var(--color-brass);" aria-hidden="true">—</span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Other team members -->
  <section style="padding: 64px 0; background: var(--color-stone);">
    <div style="max-width: 1000px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
      <h2 class="font-heading" style="text-align: center; margin-bottom: 32px; font-size: 1.3rem;">Meet the Rest of the Team</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4" style="gap: 20px;">
        {team.filter((t) => t.slug !== member.slug).map((t) => (
          <a href={`/team/${t.slug}/`} style="text-align: center; text-decoration: none; color: inherit;">
            <div style="aspect-ratio: 3/4; overflow: hidden; margin-bottom: 12px;">
              <img
                src={t.image}
                srcset={`${t.image.replace('.webp', '-400w.webp')} 400w, ${t.image.replace('.webp', '-800w.webp')} 800w`}
                sizes="(max-width: 640px) 50vw, 25vw"
                alt={`Portrait of ${t.name}, ${t.role}`}
                width="200"
                height="267"
                loading="lazy"
                style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;"
              />
            </div>
            <h3 class="font-heading" style="font-size: 0.95rem; margin-bottom: 2px;">{t.name}</h3>
            <span style="font-size: 0.72rem; color: var(--color-brass-dark); text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600;">{t.role}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTABanner />
</Layout>
