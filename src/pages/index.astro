---
import Layout from '@/layouts/Layout.astro';
import { SITE } from '@/config';
import Hero from '@/components/Hero.astro';
import BragBar from '@/components/BragBar.astro';
import BentoGrid from '@/components/BentoGrid.astro';
import ServicesGrid from '@/components/ServicesGrid.astro';
import FeaturedProjects from '@/components/FeaturedProjects.astro';
import BeforeAfter from '@/components/BeforeAfter.astro';
import ProcessTimeline from '@/components/ProcessTimeline.astro';
import StatsCounter from '@/components/StatsCounter.astro';
import TestimonialCarousel from '@/components/TestimonialCarousel.astro';
import CostEstimator from '@/components/CostEstimator.astro';
import PriceLock from '@/components/PriceLock.astro';
import ReviewBadge from '@/components/ReviewBadge.astro';
import VideoShowcase from '@/components/VideoShowcase.astro';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import ServiceAreas from '@/components/ServiceAreas.astro';
import CTABanner from '@/components/CTABanner.astro';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'HomeAndConstructionBusiness',
    name: SITE.name,
    legalName: SITE.legalName,
    description: SITE.description,
    url: SITE.url,
    logo: `${SITE.url}/favicon.svg`,
    image: `${SITE.url}/og-image.jpg`,
    telephone: SITE.phone,
    email: SITE.email,
    foundingDate: '1987',
    numberOfEmployees: {
      '@type': 'QuantitativeValue',
      minValue: 45,
    },
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.address.street,
      addressLocality: SITE.address.area,
      addressRegion: SITE.address.city,
      postalCode: SITE.address.postcode,
      addressCountry: SITE.address.country,
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: SITE.reviews.rating,
      reviewCount: SITE.reviews.count,
      bestRating: 5,
    },
    areaServed: [
      { '@type': 'AdministrativeArea', name: 'Essex' },
      { '@type': 'AdministrativeArea', name: 'East Anglia' },
      { '@type': 'City', name: 'London' },
      { '@type': 'Country', name: 'United Kingdom' },
    ],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Construction Services',
      itemListElement: [
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Bespoke New Builds' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Extensions & Additions' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Listed Buildings & Heritage' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Whole-House Renovations' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Heritage & Barn Conversions' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Project Management' } },
      ],
    },
    award: [
      'LABC Building Excellence Award 2024 — Best Residential Renovation',
      'FMB Master Builder of the Year 2023 — South East Region',
      'Checkatrade Rated People Award 2022',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    legalName: SITE.legalName,
    url: SITE.url,
    logo: `${SITE.url}/favicon.svg`,
    image: `${SITE.url}/og-image.jpg`,
    foundingDate: '1987',
    numberOfEmployees: {
      '@type': 'QuantitativeValue',
      minValue: 45,
    },
    sameAs: [
      SITE.social.facebook,
      SITE.social.instagram,
    ],
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: SITE.phone,
      contactType: 'customer service',
      availableLanguage: 'English',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
  },
];
---

<Layout
  title={`${SITE.name} | Premium Construction & Restoration`}
  description={SITE.description}
  preloadImage="/images/hero-new.webp"
  schema={schema}
>
  <Hero />
  <BragBar />
  <BentoGrid />
  <ServicesGrid />
  <FeaturedProjects />
  <BeforeAfter />
  <ProcessTimeline />
  <StatsCounter />
  <TestimonialCarousel />
  <CostEstimator />
  <PriceLock />
  <VideoShowcase />

  <!-- Newsletter Signup -->
  <section style="padding: 64px 0; background: var(--color-stone);">
    <div style="max-width: 700px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
      <NewsletterSignup variant="light" />
    </div>
  </section>

  <ServiceAreas />
  <CTABanner />
</Layout>
