---
import Layout from '@/layouts/Layout.astro';
import { SITE } from '@/config';
import { projects } from '@/data/projects';
import ProjectCard from '@/components/ProjectCard.astro';
import CTABanner from '@/components/CTABanner.astro';

const types = [...new Set(projects.map((p) => p.type))];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: `${SITE.url}/projects/` },
  ],
};
---

<Layout
  title={`Our Projects | ${SITE.name} — Portfolio of Award-Winning Construction`}
  description="Browse our portfolio of bespoke new builds, heritage restorations, barn conversions and elegant extensions. Each project tells a story of craftsmanship and collaboration."
  schema={schema}
>
  <!-- Page Header -->
  <section style="padding: 140px 0 64px; background: var(--color-charcoal);">
    <div style="max-width: 900px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px); text-align: center;">
      <span class="eyebrow eyebrow-light" style="display: block; margin-bottom: 12px;">Selected Work</span>
      <h1 class="font-heading" style="color: var(--color-text-light);">Our Projects</h1>
      <p style="font-size: 1rem; color: rgba(240,237,232,0.7); line-height: 1.8; margin-top: 16px; max-width: 600px; margin-left: auto; margin-right: auto;">
        Each project represents a unique collaboration between our team and our clients. Click any project to explore the full case study.
      </p>
    </div>
  </section>

  <!-- Filter + Grid -->
  <section style="padding: 64px 0 96px; background: var(--color-warm-white);">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
      <!-- Filter buttons -->
      <div style="display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-bottom: 48px;" id="project-filters">
        <button
          class="filter-btn active"
          data-filter="all"
          style="padding: 8px 16px; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; border: 2px solid var(--color-brass); background: var(--color-brass); color: var(--color-warm-white); cursor: pointer; transition: all 0.3s ease; font-family: var(--font-body);"
        >
          All
        </button>
        {types.map((type) => (
          <button
            class="filter-btn"
            data-filter={type}
            style="padding: 8px 16px; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; border: 2px solid var(--color-border); background: transparent; color: var(--color-text-dark); cursor: pointer; transition: all 0.3s ease; font-family: var(--font-body);"
          >
            {type}
          </button>
        ))}
      </div>

      <!-- Project grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3" style="gap: 24px;" id="project-grid">
        {projects.map((project, i) => (
          <a href={`/projects/${project.slug}/`} data-project-type={project.type} class="project-item" data-index={i} style="cursor: pointer; text-decoration: none; color: inherit; display: block;">
            <ProjectCard {...project} index={i} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTABanner />
</Layout>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectItems = document.querySelectorAll('.project-item');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      // Update active button
      filterBtns.forEach((b) => {
        const el = b as HTMLElement;
        if (b === btn) {
          el.style.background = 'var(--color-brass)';
          el.style.borderColor = 'var(--color-brass)';
          el.style.color = 'var(--color-warm-white)';
        } else {
          el.style.background = 'transparent';
          el.style.borderColor = 'var(--color-border)';
          el.style.color = 'var(--color-text-dark)';
        }
      });

      // Animated filter transition
      projectItems.forEach((card) => {
        const el = card as HTMLElement;
        const match = filter === 'all' || card.getAttribute('data-project-type') === filter;

        if (!match) {
          if (!prefersReducedMotion) {
            el.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
            el.style.opacity = '0';
            el.style.transform = 'scale(0.95)';
            setTimeout(() => { el.style.display = 'none'; }, 300);
          } else {
            el.style.display = 'none';
          }
        } else {
          el.style.display = 'block';
          if (!prefersReducedMotion) {
            el.style.opacity = '0';
            el.style.transform = 'scale(0.95)';
            requestAnimationFrame(() => {
              el.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
              el.style.opacity = '1';
              el.style.transform = 'scale(1)';
            });
          } else {
            el.style.opacity = '1';
          }
        }
      });
    });
  });

</script>
