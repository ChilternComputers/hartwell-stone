---
import Layout from '@/layouts/Layout.astro';
import { SITE } from '@/config';
import { testimonials } from '@/data/testimonials';
import { projects } from '@/data/projects';
import CTABanner from '@/components/CTABanner.astro';

function stars(count: number) {
  return '★'.repeat(count) + '☆'.repeat(5 - count);
}

// Map testimonials to project slugs via matching image paths
const projectSlugByImage = new Map(projects.map((p) => [p.image, p.slug]));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Testimonials', item: `${SITE.url}/testimonials/` },
    ],
  },
  ...testimonials.map((t) => ({
    '@context': 'https://schema.org',
    '@type': 'Review',
    author: { '@type': 'Person', name: t.name },
    reviewRating: { '@type': 'Rating', ratingValue: t.rating, bestRating: 5 },
    reviewBody: t.text,
    datePublished: t.date,
    itemReviewed: { '@type': 'HomeAndConstructionBusiness', name: SITE.name },
  })),
];
---

<Layout
  title={`Client Testimonials | ${SITE.name} — What Our Clients Say`}
  description="Read what our clients say about working with Hartwell & Stone. 4.9/5 average rating from 143 verified reviews across Google, Checkatrade and Trustpilot."
  schema={schema}
>
  <!-- Page Header -->
  <section style="padding: 140px 0 64px; background: var(--color-charcoal);">
    <div style="max-width: 900px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px); text-align: center;">
      <span class="eyebrow eyebrow-light" style="display: block; margin-bottom: 12px;">Client Reviews</span>
      <h1 class="font-heading" style="color: var(--color-text-light);">What Our Clients Say</h1>

      <!-- Aggregate rating -->
      <div style="margin-top: 24px; display: flex; justify-content: center; align-items: center; gap: 16px; flex-wrap: wrap;">
        <span style="font-size: 2rem; color: var(--color-brass-light); letter-spacing: 3px;">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <div>
          <span class="font-heading" style="font-size: 2rem; color: var(--color-text-light);">{SITE.reviews.rating}</span>
          <span style="font-size: 0.85rem; color: rgba(240,237,232,0.75);">/5 from {SITE.reviews.count} reviews</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Grid -->
  <section style="padding: 80px 0; background: var(--color-warm-white);">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
      <div class="grid grid-cols-1 md:grid-cols-2" style="gap: 24px;" data-stagger-parent>
        {testimonials.map((t) => (
          <div
            style="padding: 36px; background: var(--color-stone); border-left: 3px solid var(--color-brass); display: flex; flex-direction: column;"
            data-stagger-child
          >
            <!-- Rating + Project type -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
              <span style="color: var(--color-brass-dark); font-size: 1rem; letter-spacing: 2px;" aria-label={`${t.rating} out of 5 stars`}>
                {stars(t.rating)}
              </span>
              <span style="font-size: 0.68rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(44,44,46,0.4);">
                {t.projectType}
              </span>
            </div>
            <p style="font-size: 0.92rem; color: var(--color-text-dark); line-height: 1.8; margin-bottom: 20px; font-style: italic; flex: 1;">
              &ldquo;{t.text}&rdquo;
            </p>
            <div style="display: flex; justify-content: space-between; align-items: flex-end;">
              <div>
                <span style="font-weight: 600; color: var(--color-charcoal); display: block; font-size: 0.9rem;">
                  {t.name}
                </span>
                <span style="font-size: 0.78rem; color: var(--color-text-muted);">
                  {t.image && projectSlugByImage.has(t.image) ? (
                    <a href={`/projects/${projectSlugByImage.get(t.image)}/`} style="color: var(--color-brass-dark); text-decoration: none; font-weight: 500; transition: color 0.3s ease;" class="hover:text-charcoal">{t.project}</a>
                  ) : (
                    t.project
                  )} — {t.location}
                </span>
              </div>
              <span style="font-size: 0.72rem; color: rgba(44,44,46,0.35);">
                {new Date(t.date).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}
              </span>
            </div>
          </div>
        ))}
      </div>

      <!-- Review platform links -->
      <div style="text-align: center; margin-top: 56px; padding: 32px; background: var(--color-stone);" data-reveal>
        <p style="font-size: 0.95rem; color: var(--color-text-dark); margin-bottom: 20px;">
          Read more reviews on these platforms:
        </p>
        <div style="display: flex; justify-content: center; gap: 24px; flex-wrap: wrap;">
          <span style="font-size: 0.85rem; font-weight: 600; color: var(--color-brass-dark); letter-spacing: 0.05em;">Google Reviews</span>
          <span style="font-size: 0.85rem; font-weight: 600; color: var(--color-brass-dark); letter-spacing: 0.05em;">Checkatrade</span>
          <span style="font-size: 0.85rem; font-weight: 600; color: var(--color-brass-dark); letter-spacing: 0.05em;">Trustpilot</span>
        </div>
      </div>
    </div>
  </section>

  <CTABanner />
</Layout>
