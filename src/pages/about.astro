---
import Layout from '@/layouts/Layout.astro';
import { SITE } from '@/config';
import { team } from '@/data/team';
import StatsCounter from '@/components/StatsCounter.astro';
import CTABanner from '@/components/CTABanner.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'About', item: `${SITE.url}/about/` },
  ],
};
---

<Layout
  title={`About Us | ${SITE.name}`}
  description="Learn about Hartwell & Stone Construction — 38 years of premium residential building in Essex. Meet our team and discover our values."
  schema={schema}
>
  <!-- Page Header -->
  <section style="padding: 140px 0 64px; background: var(--color-charcoal);">
    <div style="max-width: 900px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px); text-align: center;">
      <span class="eyebrow eyebrow-light" style="display: block; margin-bottom: 12px;">Our Story</span>
      <h1 class="font-heading" style="color: var(--color-text-light);">About Hartwell & Stone</h1>
    </div>
  </section>

  <!-- Story -->
  <section style="padding: 80px 0; background: var(--color-warm-white);">
    <div style="max-width: 900px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
      <div class="grid grid-cols-1 lg:grid-cols-2" style="gap: 48px; align-items: start;">
        <div data-reveal>
          <h2 class="font-heading" style="margin-bottom: 20px;">Building Excellence Since 1987</h2>
          <p style="font-size: 0.95rem; color: rgba(44,44,46,0.7); line-height: 1.9; margin-bottom: 16px;">
            Founded by James Hartwell in Chelmsford, Hartwell & Stone began as a two-person operation with a simple philosophy: build every project as if it were our own home.
          </p>
          <p style="font-size: 0.95rem; color: rgba(44,44,46,0.7); line-height: 1.9; margin-bottom: 16px;">
            Nearly four decades later, that principle still guides everything we do. We've grown into one of Essex's most respected residential construction companies, but we've never lost the personal touch that built our reputation.
          </p>
          <p style="font-size: 0.95rem; color: rgba(44,44,46,0.7); line-height: 1.9;">
            Every project is led by a dedicated project manager. Every client has direct access to our team. Every build is backed by our 10-year structural guarantee. That's the Hartwell & Stone difference.
          </p>
        </div>
        <div data-reveal>
          <div style="background: var(--color-stone); padding: 36px; border-left: 3px solid var(--color-brass);">
            <h3 class="font-heading" style="font-size: 1.3rem; margin-bottom: 20px;">Our Values</h3>
            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px;">
              <li style="font-size: 0.9rem; color: var(--color-text-dark); display: flex; gap: 12px;">
                <span style="color: var(--color-brass); font-weight: 700; flex-shrink: 0;">01</span>
                <span><strong>Quality Without Compromise</strong> — We use premium materials and employ skilled tradespeople.</span>
              </li>
              <li style="font-size: 0.9rem; color: var(--color-text-dark); display: flex; gap: 12px;">
                <span style="color: var(--color-brass); font-weight: 700; flex-shrink: 0;">02</span>
                <span><strong>Transparent Communication</strong> — Clear pricing, regular updates and honest timelines.</span>
              </li>
              <li style="font-size: 0.9rem; color: var(--color-text-dark); display: flex; gap: 12px;">
                <span style="color: var(--color-brass); font-weight: 700; flex-shrink: 0;">03</span>
                <span><strong>Respect for Your Home</strong> — We keep sites clean, minimise disruption and protect your property.</span>
              </li>
              <li style="font-size: 0.9rem; color: var(--color-text-dark); display: flex; gap: 12px;">
                <span style="color: var(--color-brass); font-weight: 700; flex-shrink: 0;">04</span>
                <span><strong>Long-Term Relationships</strong> — Over 60% of our work comes from referrals and repeat clients.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <StatsCounter />

  <!-- Team -->
  <section style="padding: 96px 0; background: var(--color-warm-white);">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
      <div style="text-align: center; margin-bottom: 56px;" data-reveal>
        <span class="eyebrow" style="display: block; margin-bottom: 12px;">Our Team</span>
        <h2 class="font-heading">Meet the Team</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4" style="gap: 24px;" data-stagger-parent>
        {team.map((member) => (
          <div style="text-align: center;" data-stagger-child>
            <div style="width: 100%; aspect-ratio: 3/4; background: var(--color-stone); margin-bottom: 20px; overflow: hidden;">
              <img
                src={member.image}
                alt={member.name}
                width="300"
                height="400"
                loading="lazy"
                style="width: 100%; height: 100%; object-fit: cover;"
              />
            </div>
            <h3 class="font-heading" style="font-size: 1.15rem; margin-bottom: 4px;">{member.name}</h3>
            <span style="font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-brass); display: block; margin-bottom: 12px;">
              {member.role}
            </span>
            <p style="font-size: 0.85rem; color: rgba(44,44,46,0.65); line-height: 1.7;">
              {member.bio}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Accreditations -->
  <section style="padding: 80px 0; background: var(--color-stone);">
    <div style="max-width: 900px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
      <div style="text-align: center; margin-bottom: 48px;" data-reveal>
        <span class="eyebrow" style="display: block; margin-bottom: 12px;">Credentials</span>
        <h2 class="font-heading">Accreditations & Memberships</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2" style="gap: 20px;" data-stagger-parent>
        <div style="padding: 28px; background: var(--color-warm-white); border: 1px solid var(--color-border);" data-stagger-child>
          <h3 style="font-family: var(--font-body); font-size: 0.95rem; font-weight: 600; color: var(--color-charcoal); margin-bottom: 8px;">Federation of Master Builders</h3>
          <p style="font-size: 0.85rem; color: rgba(44,44,46,0.65); line-height: 1.7;">{SITE.accreditations.fmb}. Independently vetted and bound by a strict code of practice.</p>
        </div>
        <div style="padding: 28px; background: var(--color-warm-white); border: 1px solid var(--color-border);" data-stagger-child>
          <h3 style="font-family: var(--font-body); font-size: 0.95rem; font-weight: 600; color: var(--color-charcoal); margin-bottom: 8px;">TrustMark</h3>
          <p style="font-size: 0.85rem; color: rgba(44,44,46,0.65); line-height: 1.7;">{SITE.accreditations.trustmark}. Government-endorsed quality scheme with financial protection.</p>
        </div>
        <div style="padding: 28px; background: var(--color-warm-white); border: 1px solid var(--color-border);" data-stagger-child>
          <h3 style="font-family: var(--font-body); font-size: 0.95rem; font-weight: 600; color: var(--color-charcoal); margin-bottom: 8px;">Checkatrade</h3>
          <p style="font-size: 0.85rem; color: rgba(44,44,46,0.65); line-height: 1.7;">Verified member with 120+ verified reviews and a 9.8/10 average rating.</p>
        </div>
        <div style="padding: 28px; background: var(--color-warm-white); border: 1px solid var(--color-border);" data-stagger-child>
          <h3 style="font-family: var(--font-body); font-size: 0.95rem; font-weight: 600; color: var(--color-charcoal); margin-bottom: 8px;">LABC</h3>
          <p style="font-size: 0.85rem; color: rgba(44,44,46,0.65); line-height: 1.7;">Local Authority Building Control partner. All builds inspected and certified.</p>
        </div>
      </div>
    </div>
  </section>

  <CTABanner />
</Layout>
